fn diff(a: [str], b: [str]):
    let n, m = a.len(), b.len()
    var L = [[0].repeat(m + 1)].repeat(n + 1)
    for i in n - 1..-1 step -1:
        for j in m - 1..-1 step -1:
            if a[i] == b[j]:
                L[i][j] = L[i + 1][j + 1] + 1
            else:
                L[i][j] = max(L[i + 1][j], L[i][j + 1])
    var i, j = 0, 0
    var run = []
    var ins, del, unc = 0, 0, 0
    while i < n || j < m:
        if i < n && j < m && a[i] == b[j]:
            run.push(a[i])
            unc += 1
            i += 1
            j += 1
        else:
            flush(run)
            run = []
            if i < n && (j == m || L[i + 1][j] >= L[i][j + 1]):
                print("- {a[i]}")
                del += 1
                i += 1
            else:
                print("+ {b[j]}")
                ins += 1
                j += 1
    flush(run)
    print("summary: +{ins} -{del} ={unc}")

fn flush(run: [str]):
    if run.len() >= 3:
        print("= ({run.len()} unchanged)")
    else:
        for s in run: print("= {s}")

print("diff 1")
diff(["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa"],
    ["alpha", "gamma", "delta", "beta", "epsilon", "zeta", "eta", "lambda", "theta", "kappa", "mu"])
print("diff 2")
diff(["x = 1", "y = 2", "print(x)", "print(y)", "z = x + y", "print(z)"],
    ["y = 2", "x = 1", "print(x)", "z = x + y", "print(z)", "print(y)"])
