fn money(c: int) = "{c / 100:,}.{c % 100:02}"

fn cut(s: str) = "{s.slice(0, 9)}~" if s.len() > 10 else s

fn cell(s: str, w: int, a: int):
    let pad = w - s.len()
    if a == 0: ret s + " ".repeat(pad)
    if a == 1: ret " ".repeat(pad) + s
    let left = pad / 2
    " ".repeat(left) + s + " ".repeat(pad - left)

fn border(ws: [int], ch: str) = "+" + ws.map(w => ch.repeat(w + 2) + "+").join("")

fn rowline(r: [str], ws: [int], al: [int]) = "| " + [cell(c, ws[i], al[i]) for i, c in r].join(" | ") + " |"

let items = [("bolts", 12000, 5, "bulk"), ("hex nuts", 350, 12, "galvanized"), ("washers", 7, 123456, "special order"), ("anchor", 1, 99, ""), ("rivets", 1500, 3, "aluminium"), ("brackets", 24, 1050, "left-hand only")]
let header = ["item", "qty", "price", "amount", "note"]
let al = [0, 1, 1, 1, 2]
var rows = []
var tq, ta = 0, 0
for name, q, p, n in items:
    tq += q
    ta += q * p
    rows.push([name, "{q:,}", money(p), money(q * p), cut(n)])
let total = ["TOTAL", "{tq:,}", "", money(ta), ""]
let ws = [([header] + rows + [total]).map(r => r[j].len()).max() for j in 0..5]
print(border(ws, "-"))
print(rowline(header, ws, al))
print(border(ws, "="))
for r in rows:
    print(rowline(r, ws, al))
print(border(ws, "-"))
print(rowline(total, ws, al))
print(border(ws, "-"))
