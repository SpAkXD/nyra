let words = "the quick brown fox jumps over the lazy dog and keeps running far away from here".split(" ")
var lines = []
var cur = ""
for w in words:
    if cur == "":
        cur = w
    elif cur.len() + 1 + w.len() <= 18:
        cur += " " + w
    else:
        lines.push(cur)
        cur = w
if cur != "": lines.push(cur)
for l in lines: print(l)
print("lines: {lines.len()}")
