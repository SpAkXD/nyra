bank = [:]
cmds = "open A 100; open B 50; open A 10; deposit C 5; withdraw B 70; transfer A B 60; transfer B A 112; transfer B A 109; transfer A A 5; withdraw A 25; close B; transfer A B 1; deposit A 7; withdraw A 15; close A; open B 0; close B".split("; ")
for c in cmds:
    p = c.split(" ")
    op, x = p[0], p[1]
    if op == "open":
        if x in bank:
            print("{x} exists")
        else:
            bank[x] = int(p[2])
            print("opened {x}")
    elif op == "deposit":
        if x not in bank:
            print("{x} unknown")
        else:
            bank[x] += int(p[2])
            print("{x} balance {bank[x]}")
    elif op == "withdraw":
        n = int(p[2])
        if x not in bank:
            print("{x} unknown")
        elif bank[x] - n < 0:
            print("{x} insufficient")
        else:
            bank[x] -= n
            print("{x} balance {bank[x]}")
    elif op == "transfer":
        y, amt = p[2], int(p[3])
        if x not in bank || y not in bank:
            print("unknown account")
        elif bank[x] < amt + 1:
            print("{x} insufficient")
        elif x == y:
            bank[x] -= 1
            print("{x} balance {bank[x]} {y} balance {bank[y]}")
        else:
            bank[x] -= amt + 1
            bank[y] += amt
            print("{x} balance {bank[x]} {y} balance {bank[y]}")
    elif op == "close":
        if x not in bank:
            print("{x} unknown")
        elif bank[x] != 0:
            print("{x} not empty")
        else:
            bank.remove(x)
            print("closed {x}")
