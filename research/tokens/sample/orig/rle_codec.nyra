struct Res { ok: bool, text: str }

fn encode(s: str) -> str {
    var out = ""
    var i = 0
    let n = s.len()
    while i < n {
        let c = s[i]
        var j = i
        while j < n && s[j] == c { j += 1 }
        let k = j - i
        if c == '~' {
            out += "~{k}~"
        } else if k >= 4 {
            out += "~{k}" + str(c)
        } else {
            out += str(c).repeat(k)
        }
        i = j
    }
    ret out
}

fn decode(s: str) -> Res {
    let bad = Res(ok: false, text: "")
    var out = ""
    var i = 0
    let n = s.len()
    while i < n {
        let c = s[i]
        if c == '~' {
            i += 1
            if i >= n { ret bad }
            if !s[i].is_digit() || s[i] == '0' { ret bad }
            var count = 0
            while i < n && s[i].is_digit() {
                count = count * 10 + (s[i].code() - '0'.code())
                i += 1
            }
            if i >= n { ret bad }
            let c2 = s[i]
            if !(c2.is_lower() || c2 == '.' || c2 == '~') { ret bad }
            out += str(c2).repeat(count)
            i += 1
        } else {
            if !(c.is_lower() || c == '.') { ret bad }
            out += str(c)
            i += 1
        }
    }
    ret Res(ok: true, text: out)
}

let texts = ["aaaabbbcccccd", "~~x", ".......", "abc", "zzzzzzzzzzzzzz~", "a~~~~b"]
for t in texts {
    print("encode {t} -> {encode(t)}")
}
let codes = ["~4a~3~b", "~04a", "~2ab", "a~b", "~12z", "~5", "ab~3~~", "x~1~y", "q7", "~10.~4~", "~1~~1~", "a~3B"]
for c in codes {
    let r = decode(c)
    if !r.ok {
        print("decode {c} -> invalid")
    } else if encode(r.text) == c {
        print("decode {c} -> {r.text}")
    } else {
        print("decode {c} -> {r.text} (non-canonical)")
    }
}
