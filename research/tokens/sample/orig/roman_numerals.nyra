fn roman(n: int) -> str {
    let vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
    let syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
    var x = n
    var out = ""
    for i in 0..vals.len() {
        while x >= vals[i] {
            out = out + syms[i]
            x -= vals[i]
        }
    }
    ret out
}

fn main() {
    for n in [4, 9, 14, 40, 90, 400, 1994, 2024] {
        print(roman(n))
    }
}
