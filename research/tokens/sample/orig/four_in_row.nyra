fn run(g: [[char]], r: int, c: int, dr: int, dc: int, p: char) -> int {
    var cnt = 0
    var rr = r + dr
    var cc = c + dc
    while rr >= 0 && rr < 5 && cc >= 0 && cc < 6 && g[rr][cc] == p {
        cnt += 1
        rr += dr
        cc += dc
    }
    ret cnt
}

fn wins(g: [[char]], r: int, c: int, p: char) -> bool {
    let dirs = [[0, 1], [1, 0], [1, 1], [1, -1]]
    for d in dirs {
        let total = 1 + run(g, r, c, d[0], d[1], p) + run(g, r, c, -d[0], -d[1], p)
        if total >= 4 {
            ret true
        }
    }
    ret false
}

fn main() {
    let games = [
        [3, 4, 3, 4, 3, 4, 3],
        [1, 2, 2, 3, 3, 4, 3, 4, 4, 6, 4],
        [6, 6, 6, 6, 6, 6],
        [2, 3, 4, 5, 1, 2, 3, 4, 7],
        [1, 1, 2, 2, 4, 4, 3, 5, 5],
        [4, 3, 3, 2, 2, 1, 2, 1, 1, 5, 1],
        [1, 2, 3, 4, 5, 6, 6, 5]
    ]
    for gi, moves in games {
        var grid = [['.'].repeat(6)].repeat(5)
        var result = ""
        var done = false
        for i, m in moves {
            if done {
                break
            }
            let p = if i % 2 == 0 { 'X' } else { 'O' }
            let n = i + 1
            if m < 1 || m > 6 {
                result = "illegal move {n} by {p}"
                done = true
                break
            }
            if grid[0][m - 1] != '.' {
                result = "illegal move {n} by {p}"
                done = true
                break
            }
            var r = 4
            while grid[r][m - 1] != '.' {
                r -= 1
            }
            grid[r][m - 1] = p
            if wins(grid, r, m - 1, p) {
                result = "{p} wins at move {n}"
                done = true
            }
        }
        if !done {
            var full = true
            for row in grid {
                if row.contains('.') {
                    full = false
                }
            }
            if full {
                result = "draw"
            } else {
                result = "no winner after {moves.len()} moves"
            }
        }
        print("game {gi + 1}: {result}")
        for row in grid {
            print(row.join(""))
        }
    }
}
