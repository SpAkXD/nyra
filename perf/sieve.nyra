// sieve of Eratosthenes to 10,000,000, ten rounds
fn count_primes(n: int) -> int {
    var sieve = [true].repeat(n + 1)
    sieve[0] = false
    sieve[1] = false
    var i = 2
    while i * i <= n {
        if sieve[i] {
            var j = i * i
            while j <= n {
                sieve[j] = false
                j += i
            }
        }
        i += 1
    }
    var count = 0
    for k in 0..n + 1 {
        if sieve[k] {
            count += 1
        }
    }
    ret count
}

fn main() {
    var total = 0
    for round in 0..10 {
        total += count_primes(10000000 - round)
    }
    print(total)
}
