// nested-loop dynamic programming: 0/1 knapsack (one array) and LCS (a 2D table)
fn knapsack(weights: [int], values: [int], cap: int) -> int {
    var best = [0].repeat(cap + 1)
    for k in 0..weights.len() {
        let w = weights[k]
        let v = values[k]
        var c = cap
        while c >= w {
            let take = best[c - w] + v
            if take > best[c] {
                best[c] = take
            }
            c -= 1
        }
    }
    ret best[cap]
}

fn lcs(a: [int], b: [int]) -> int {
    let n = a.len()
    let m = b.len()
    var dp = [[0].repeat(m + 1)].repeat(n + 1)
    for i in 1..n + 1 {
        for j in 1..m + 1 {
            if a[i - 1] == b[j - 1] {
                dp[i][j] = dp[i - 1][j - 1] + 1
            } else {
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])
            }
        }
    }
    ret dp[n][m]
}

fn main() {
    var seed = 42
    var weights: [int] = []
    var values: [int] = []
    for k in 0..1000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        weights.push((seed / 65536) % 1000 + 1)
        seed = (seed * 1103515245 + 12345) % 2147483648
        values.push((seed / 65536) % 1000 + 1)
    }
    print(knapsack(weights, values, 50000))
    var a: [int] = []
    var b: [int] = []
    for k in 0..2500 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        a.push((seed / 65536) % 4)
        seed = (seed * 1103515245 + 12345) % 2147483648
        b.push((seed / 65536) % 4)
    }
    print(lcs(a, b))
}
