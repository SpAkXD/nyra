// Perfect numbers: equal to the sum of their proper divisors (6 = 1 + 2 + 3).
fn divisor_sum(n: int) -> int {
    var sum = 1
    var d = 2
    while d * d <= n {
        if n % d == 0 {
            sum = sum + d
            if d * d != n { sum = sum + n / d }
        }
        d = d + 1
    }
    return sum
}

fn is_perfect(n: int) -> bool {
    return n > 1 && divisor_sum(n) == n
}

fn main() {
    for n in 1..10000 {
        if is_perfect(n) { print(n) }
    }
}
