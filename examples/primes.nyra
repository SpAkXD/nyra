fn is_prime(n: int) -> bool {
    if n < 2 { ret false }
    var d = 2
    while d * d <= n {
        if n % d == 0 { ret false }
        d = d + 1
    }
    ret true
}

var count = 0
for n in 0..100000 {
    if is_prime(n) { count = count + 1 }
}
print(count)
