// Shorter ways to say common things: sorted copies, best by a key, membership, zip, chunks, slices.
struct Word {
    text: str
    count: int
}

let xs = [5, 3, 8, 1]
print(xs.sorted(), xs)
let names = ["bob", "al", "christine", "di"]
print(names.sorted(), names.sorted().reversed())

// sorted_by: a new array, ordered by a key; a tuple key sorts by its parts in turn
let words = [Word(text: "pear", count: 2), Word(text: "fig", count: 5), Word(text: "apple", count: 2), Word(text: "kiwi", count: 5)]
for w in words.sorted_by(w => (-w.count, w.text)) {
    print("{w.text}:{w.count}")
}
print(names.sorted_by(s => s.len()))
print(names.sorted_by(s => (s.len() % 2 == 0, s)))
print(words.sorted_by(w => w.count).map(w => w.text))

// min_by / max_by give the first element with the smallest / largest key
print(names.min_by(s => s.len()), names.max_by(s => s.len()))
print(words.max_by(w => (w.count, w.text)).text, words.min_by(w => (w.count, w.text)).text)
print([4, -9, 7].max_by(x => abs(x)), [4, -9, 7].min_by(x => abs(x)))

// `in` for arrays, text and maps
let ages = ["ann": 31, "bob": 27]
print(3 in xs, 4 in xs, "al" in names, "ann" in ages, "cy" in ages)
print('b' in "abc", "bc" in "abcd", "x" in "abc", 'z' in "abc")
if 8 in xs && !(9 in xs) {
    print("8 yes, 9 no")
}
print([x for x in 0..10 if x in [2, 3, 5, 7]])

// zip pairs up two or three arrays (or texts), as many as the shortest has
print(zip([1, 2, 3], ["a", "b", "c"]))
print(zip(names, xs))
for (n, i) in zip("abc", [10, 20, 30, 40]) {
    print("{n}{i}")
}
print(zip([1, 2], [3, 4], [5, 6]), zip("ab", "xy"))
let empty: [int] = []
print(zip(empty, xs))

// chunks, and slices that leave out either end
print([1, 2, 3, 4, 5].chunks(2), "abcdefg".chunks(3), empty.chunks(4))
let ys = [10, 20, 30, 40, 50]
print(ys[1..3], ys[..2], ys[3..], ys[..], ys[2..2])
let s = "hello world"
print(s[0..5], s[6..], s[..5], "{s[1..4]}!")
print(ys[1..ys.len() - 1].sum())

// trim the characters you name
print("[{"  --hi--  ".trim()}] [{"--hi--".trim("-")}] [{"xxhixx".trim('x')}] [{"a.b,".trim(".,")}]")

// items of a map as pairs
for (k, v) in ages.items() {
    print("{k} is {v}")
}
print(ages.items())

// var parameters: the function changes its own copy
fn countdown(var n: int) -> int {
    var steps = 0
    while n > 0 {
        n -= 1
        steps += 1
    }
    ret steps
}
fn shout(var s: str, var xs: [int]) -> str {
    s += "!"
    xs.push(len_of(s))
    ret s + str(xs)
}
fn len_of(s: str) -> int = s.len()   ex len_of("abc") == 3
fn top(xs: [int]) -> [int] = xs.sorted().reversed()   ex top([3, 1, 2]) == [3, 2, 1], zip([1, 2], "ab").len() == 2
fn first_two(xs: [int]) -> [int] = xs[..2]   ex first_two([5, 6, 7]) == [5, 6], 3 in [1, 3]
var k = 3
print(countdown(k), k)
let base = [1]
print(shout("hey", base), base)

// a function called like a method: the first argument comes before the dot
fn area(r: Word) -> int = r.count * 10
fn double(x: int) -> int = x * 2
fn bump(inout w: Word, by: int) {
    w.count += by
}
let four = 4
print(words[0].area(), four.double().double(), xs.sorted().len())
var w = words[1]
w.bump(3)
print(w)
