// `print(..., end: e)` prints `e` instead of the line end: several prints on one line.
fn main() {
    for row in 0..3 {
        for col in 0..4 {
            print(row * col, end: " ")
        }
        print("|")
    }
    print("no line end", end: "")
    print(" ... then the rest", 42, end: "!\n")
    var n = 0
    print("{n}", n + 1, end: ".{n}\n")
    let sep = ", "
    for w in ["a", "b", "c"] {
        print(w, end: sep)
    }
    print("")
}
