// Greatest common divisor (Euclid's algorithm) and least common multiple.
fn gcd(a: int, b: int) -> int {
    if b == 0 { ret a }
    ret gcd(b, a % b)
}

fn lcm(a: int, b: int) -> int {
    ret a / gcd(a, b) * b
}

print(gcd(48, 18))
print(gcd(17, 5))
print(lcm(4, 6))
print(lcm(21, 6))

// the smallest number divisible by every number from 1 to 10
var l = 1
for n in 1..11 {
    l = lcm(l, n)
}
print(l)
