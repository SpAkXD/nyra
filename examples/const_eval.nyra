// compile-time evaluation: pure calls with constant arguments fold; the output never changes
fn fib(n: int) -> int {
    if n < 2 {
        ret n
    }
    ret fib(n - 1) + fib(n - 2)
}

fn greet(name: str, n: int) -> str {
    var s = ""
    for i in 0..n {
        s += "{name}{i},"
    }
    ret s.upper()
}

fn half(x: float) -> float = x / 2.0

fn noisy(n: int) -> int {
    print("side effect {n}")
    ret n
}

fn spin(n: int) -> int {
    var i = 0
    var acc = 0
    while i < n {
        acc = (acc * 31 + i) % 1000003
        i += 1
    }
    ret acc
}

fn main() {
    let m = 7
    print(fib(20))
    print(greet("ab", 3))
    print(half(3.0) + 0.1)
    print(0.1 + 0.2)
    print(1.0 / 3.0)
    print(-0.0 * 1.0)
    print(noisy(3))
    print(100 % m, -100 / m)
    print("héllo".len(), "héllo".index_of("l"), 'a'.upper())
    print(int("-42") + 1, char(66), "abc" < "abd")
    print(spin(10), spin(3000000))
    var total = 0
    for n in 0..m {
        total += fib(n)
    }
    print(total)
}
