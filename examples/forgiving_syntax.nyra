// forms that models write naturally: braces as text, operators that continue a line,
// `ret` after a statement in a one-line block, a helper function written inside a function
let code = "fn main() {"
print(code, code.index_of("{"), "expected } but found )", "{}")
let n = 4
print("n = {n} {", "{{literal}}")

let total = 10 * n
          - 3
          + 1
let count = [3, -1, 4, -1, 5].filter(x => x > 0)
                              .len()
print(total, count)

fn grade(score: int) -> str {
    fn passed(s: int) -> bool = s >= 50
    if score < 0 { print("bad score") ret "?" }
    ret if passed(score) { "pass" } else { "fail" }
}
print(grade(70), grade(20), grade(-1))
print('\0'.code(), "a\0b".len())
