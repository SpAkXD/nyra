// `use math`: the same digits on every backend (the transcendental functions are written in
// Nyra, so every target runs the same operations).
use math

fn main() {
    print(math.pi, math.e, math.inf, -math.inf)
    print(math.sqrt(2.0), math.sqrt(-1.0), math.floor(-2.5), math.ceil(-2.5), math.trunc(-2.7))
    print(math.round(2.5), math.round(-2.5), math.round(0.49999999999999994), math.round(-0.4))
    print(math.exp(1.0), math.exp(-1.0), math.exp(10.0), math.exp(710.0), math.exp(-746.0))
    print(math.log(2.0), math.log(10.0), math.log(0.0), math.log(-1.0), math.log(math.e))
    print(math.log10(1000.0), math.log10(2.0), math.log2(1024.0), math.log2(10.0))
    print(math.pow(2.0, 10.0), math.pow(10.0, 15.0), math.pow(2.0, 0.5), math.pow(1.5, 2.5), math.pow(-2.0, 3.0), math.pow(-8.0, 1.0 / 3.0))
    print(math.pow(0.0, -1.0), math.pow(-0.0, -3.0), math.pow(2.0, -1074.0), math.pow(10.0, 308.0), math.pow(10.0, 309.0), math.pow(1.0, 0.0 / 0.0))
    print(math.sin(1.0), math.cos(1.0), math.tan(1.0), math.sin(math.pi), math.cos(math.pi / 2.0))
    print(math.sin(-0.5), math.cos(100.0), math.tan(1.5707963267948966), math.sin(1000000.0), math.cos(-1000000000.0))
    print(math.atan(1.0), math.atan2(1.0, -1.0), math.atan2(-0.0, -1.0), math.asin(0.5), math.acos(0.5), math.acos(-1.0), math.asin(2.0))
    // degrees to radians and back
    let deg = 30.0
    let rad = deg * math.pi / 180.0
    print(math.sin(rad), math.round(math.asin(math.sin(rad)) * 180.0 / math.pi))
    // compound interest with pow: 1000 at 5% for 10 years
    print(math.round(1000.0 * math.pow(1.05, 10.0) * 100.0) / 100.0)
}
