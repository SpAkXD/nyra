// Reads standard input line by line (`std_input.in`): Windows line ends, an empty line,
// and a last line without a line end all read the same on every backend.
use input
use text

var total = 0
var words: [str] = []
var n = 0
while !input.eof() {
    let line = input.line()
    n += 1
    if text.is_int(line) {
        total += int(line)
    } else if line != "" {
        words.push(line)
    }
    print("{n}: [{line}] ({line.len()} characters)")
}
print("sum of the numbers: {total}")
print("words: {words.join(", ")}")
print("after the end: [{input.line()}] {input.eof()}")
