// `text.fixed` rounds the exact value of a float (ties away from zero); `text.is_int` and
// `text.is_float` tell whether `int(s)` and `float(s)` would succeed.
use text

print(text.fixed(3.14159, 2), text.fixed(2.0 / 3.0, 4), text.fixed(10.0, 0), text.fixed(0.5, 0), text.fixed(-0.5, 0))
print(text.fixed(1.005, 2), text.fixed(0.125, 2), text.fixed(2.675, 2), text.fixed(-0.001, 2), text.fixed(1.5, 3))
print(text.fixed(123456789.987654321, 3), text.fixed(0.1, 20), text.fixed(1.0 / 0.0, 2), text.fixed(0.0 / 0.0, 1))
print(text.fixed(1000000000000000000000.0, 1), text.fixed(0.000001234, 8), text.fixed(float("5e-324"), 3), text.fixed(float("1.7976931348623157e308"), 0).len())
for s in ["42", "-7", "007", "1.5", "", "-", "9223372036854775807", "9223372036854775808", " 1", "1e3"] {
    print("\"{s}\": int {text.is_int(s)}, float {text.is_float(s)}")
}
