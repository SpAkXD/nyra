// arrays: values with copy on write
fn sum(xs: [int]) -> int {
    var total = 0
    for x in xs {
        total += x
    }
    ret total
}

fn squares(n: int) -> [int] {
    var out: [int] = []
    for i in 0..n {
        out.push(i * i)
    }
    ret out
}

let xs = [3, 1, 2]
print(xs)
print(xs.len())
print(xs[0] + xs[2])
print(sum(xs))
print(squares(5))
var ys = xs
ys.push(10)
