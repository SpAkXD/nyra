{
    "name": "nyra",
    "displayName": "Nyra",
    "description": "Syntax highlighting and the file icon for the Nyra programming language",
    "version": "0.4.0",
    "publisher": "spakxd",
    "license": "MIT",
    "icon": "icons/nyra-128.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/SpAkXD/nyra"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "nyra",
                "aliases": ["Nyra", "nyra"],
                "extensions": [".nyra"],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/nyra.svg",
                    "dark": "./icons/nyra.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "nyra",
                "scopeName": "source.nyra",
                "path": "./syntaxes/nyra.tmLanguage.json"
            }
        ]
    }
}
