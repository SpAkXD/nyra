{
    "name": "nyra",
    "displayName": "Nyra",
    "description": "Nyra for VS Code: errors as you type, hover, completion, go to definition, formatting and quick fixes (through `nyra lsp`), syntax highlighting and the file icon",
    "version": "0.5.0",
    "publisher": "spakxd",
    "license": "MIT",
    "icon": "icons/nyra-128.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/SpAkXD/nyra"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages",
        "Linters",
        "Formatters"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:nyra"
    ],
    "contributes": {
        "languages": [
            {
                "id": "nyra",
                "aliases": ["Nyra", "nyra"],
                "extensions": [".nyra"],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/nyra.svg",
                    "dark": "./icons/nyra.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "nyra",
                "scopeName": "source.nyra",
                "path": "./syntaxes/nyra.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "nyra.restartServer",
                "title": "Nyra: Restart the language server"
            }
        ],
        "configuration": {
            "title": "Nyra",
            "properties": {
                "nyra.path": {
                    "type": "string",
                    "default": "nyra",
                    "markdownDescription": "The `nyra` executable that runs the language server (`nyra lsp`, Nyra 0.9 or later). The default finds it on `PATH`; give a full path otherwise."
                },
                "nyra.lsp.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Start the language server: errors as you type, hover, completion, go to definition, formatting and quick fixes."
                },
                "nyra.formatOnSave": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "markdownDescription": "Format Nyra files when they are saved (`nyra fmt`). VS Code's own `editor.formatOnSave` works too."
                }
            }
        }
    }
}
