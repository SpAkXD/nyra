use web
site("Autoservis Dvořák", primary: "#1F4E8C", accent: "#F2A900", bg: "#F4F5F7", font: "Source Sans 3", display: "Barlow Condensed", radius: 16, style: "soft")

enum Msg { Tab(str), Size(int), Toggle(int) }

let tabNames = ["Servicing", "Tyres", "Diagnostics", "Bodywork"]
let tabText = [
    "Scheduled servicing to the maker's plan, so your warranty stays valid.",
    "Seasonal tyre changes, storage and repairs while you wait.",
    "We read the fault codes and find the real cause before we replace anything.",
    "Dents, scratches and paint, matched in our own paint shop."
]
let tabItems = [
    ["Oil and filter change", "Brake check and fluids", "Stamp in your service book"],
    ["Tyre fitting and balancing", "Tyre hotel for 1,200 Kč a season", "Puncture repair"],
    ["Engine and electronics diagnostics", "Air-con check and refill", "Pre-purchase inspection"],
    ["Dent repair", "Colour-matched paintwork", "Insurance claims handled for you"]
]
let sizes = ["Small car", "Family car", "SUV / van"]
let svcNames = ["Oil service", "Front brake pads", "Air-con service", "Wheel alignment", "Tyre change (4 wheels)"]
let svcPrices = [[1490, 1790, 2290], [2190, 2590, 3190], [1290, 1290, 1590], [990, 990, 1290], [800, 960, 1200]]

var tab = 0
var size = 1
var picked = [false, false, false, false, false]

fn money(n: int) -> str {
    if n >= 1000 {
        let r = n % 1000
        return "{n / 1000},{r.pad_left(3, "0")} Kč"
    }
    return "{n} Kč"
}

fn update(m: Msg) {
    match m {
        Msg.Tab(i) => tab = i
        Msg.Size(i) => size = i
        Msg.Toggle(i) => picked[i] = !picked[i]
    }
}

fn services() -> Node = stack {
    row {
        for i, t in tabNames { button(t, on: Msg.Tab(i), active: i == tab) }
    }
    card(tabNames[tab], tabText[tab], items: tabItems[tab])
}

fn calc() -> Node = stack {
    row {
        for i, s in sizes { button(s, on: Msg.Size(i), active: i == size) }
    }
    row {
        for i, s in svcNames {
            button("{s} · {money(svcPrices[i][size])}", on: Msg.Toggle(i), active: picked[i], icon: picked[i] ? "check" : "plus")
        }
    }
    h3("Estimated total: {money(total())}")
    button("Book this service", "#contact", style: "accent")
}

fn total() -> int {
    var sum = 0
    for i, s in svcNames {
        if picked[i] { sum += svcPrices[i][size] }
    }
    return sum
}

page("/", "Autoservis Dvořák – honest car repairs in Pardubice", desc: "Independent car repair shop on Hradecká in Pardubice: servicing, tyres, diagnostics and bodywork for all makes, with fixed prices and a 2-year warranty.") {
    navbar("Autoservis Dvořák", [("Services", "#services"), ("Prices", "#prices"), ("How it works", "#process"), ("Team", "#team"), ("Contact", "#contact")], cta: ("Book a service", "#contact"))
    hero("Honest repairs, done right the first time", kicker: "Pardubice · Hradecká 88 · all makes", text: "Servicing, tyres, diagnostics and bodywork for every make. Fixed prices up front and a call before any extra work.", image: "https://picsum.photos/seed/dvorak-hero/1600/1000", alt: "A mechanic working under a lifted car at Autoservis Dvořák", buttons: [("Get a price", "#prices"), ("Book a service", "#contact")], anim: "rise")
    section("numbers", "", anim: "rise") {
        grid(4, anim: "stagger", hover: "lift") {
            stat("24", "years in Pardubice")
            stat("9,800", "cars serviced last year")
            stat("6", "certified mechanics")
            stat("2 years", "warranty on parts and labour")
        }
    }
    section("services", "What we do", kicker: "Services", bg: "alt", anim: "rise") {
        services()
    }
    section("prices", "Get a price in ten seconds", kicker: "Prices", text: "Fixed prices including VAT, parts and labour.", anim: "rise") {
        calc()
    }
    section("process", "Four steps, no surprises", kicker: "How it works", bg: "alt", anim: "rise") {
        steps([("Book online or call", "Pick a time that suits you. Most services are done the same day."), ("Drop off your car", "Leave the key at the desk, or in our key box before 7:00."), ("We call before extra work", "If we find anything else, you decide. Nothing is done without your OK."), ("Pick up and pay", "Pay by card or bank transfer. Every job comes with a 2-year warranty.")])
    }
    section("team", "The people under the bonnet", kicker: "Team", anim: "rise") {
        grid(4, anim: "stagger", hover: "lift") {
            card("Jiří Dvořák", "Opened the shop in 2002 and still checks every car that leaves it.", image: "https://picsum.photos/seed/dvorak-team-1/600/700", tag: "Owner, master mechanic")
            card("Pavel Svoboda", "Finds the electrical faults that other garages gave up on.", image: "https://picsum.photos/seed/dvorak-team-2/600/700", tag: "Diagnostics")
            card("Martina Veselá", "Explains every line of your invoice in plain words.", image: "https://picsum.photos/seed/dvorak-team-3/600/700", tag: "Service advisor")
            card("Lukáš Král", "Matches any colour, from a 1990s Škoda to a brand-new Tesla.", image: "https://picsum.photos/seed/dvorak-team-4/600/700", tag: "Bodywork and paint")
        }
    }
    section("testimonials", "What drivers say", bg: "alt", anim: "rise") {
        grid(3, anim: "stagger", hover: "lift") {
            quote("They called before changing anything, and the price was exactly as quoted.", "Michal T.")
            quote("Found an electrical fault that two other garages missed.", "Simona K.")
            quote("Tyres changed in 30 minutes while I had a coffee.", "Radek P.")
        }
    }
    section("contact", "Book your car in", kicker: "Contact", anim: "rise") {
        grid(2) {
            stack {
                address {
                    "Hradecká 88, 500 03 Pardubice"
                    link("Open in Google Maps", "https://maps.google.com/?q=Hradecká+88,+Pardubice")
                }
                link("+420 466 000 245", "tel:+420466000245")
                link("servis@autodvorak.cz", "mailto:servis@autodvorak.cz")
                hours([("Monday–Friday", "7:00–17:00"), ("Saturday", "8:00–12:00 (tyres only)"), ("Sunday", "")])
            }
            form("Book your car in", mailto: "servis@autodvorak.cz", subject: "Service booking", send: "Book service") {
                field("name", "Name", req: true)
                field("phone", "Phone", type: "tel", req: true)
                field("email", "E-mail", type: "email")
                field("car", "Car make and model", req: true)
                field("service", "Service", type: "select", req: true, options: ["Servicing", "Tyres", "Diagnostics", "Bodywork", "Something else"])
                field("date", "Preferred date", type: "date")
                field("message", "Message", type: "area")
            }
        }
    }
    footer(text: "Autoservis Dvořák", links: [("Services", "#services"), ("Prices", "#prices"), ("How it works", "#process"), ("Team", "#team"), ("Contact", "#contact")], contact: ["Hradecká 88, 500 03 Pardubice"], small: ["© 2026 Autoservis Dvořák s.r.o."])
}
