use web

site(
  "Forge Fitness Studio",
  primary: "#E4572E",
  accent: "#F3C969",
  bg: "#111315",
  display: "Archivo",
  font: "Inter",
  radius: 8,
  style: "dark"
)

enum Msg {
  FilterDay(str),
  SwitchBilling(str),
  OpenGallery(int),
  CloseGallery,
  NextGallery,
  PrevGallery
}

var activeDay = "All"
var activeBilling = "monthly"
var galleryOpen = false
var galleryIndex = 0

fn update(m: Msg) {
  match m {
    Msg.FilterDay(d) => activeDay = d,
    Msg.SwitchBilling(b) => activeBilling = b,
    Msg.OpenGallery(i) => { galleryOpen = true; galleryIndex = i },
    Msg.CloseGallery => galleryOpen = false,
    Msg.NextGallery => galleryIndex = (galleryIndex + 1) % 8,
    Msg.PrevGallery => galleryIndex = (galleryIndex + 7) % 8
  }
}

fn classCards() -> Node = {
  let classes = [
    ("Mon", "6:00", "Sunrise Strength", "Adam", "All levels"),
    ("Mon", "18:00", "Kettlebell Basics", "Klára", "Beginner"),
    ("Tue", "7:00", "Mobility Flow", "Tereza", "All levels"),
    ("Tue", "19:00", "Power Circuit", "Ondřej", "Advanced"),
    ("Wed", "6:00", "Engine Builder", "Adam", "Intermediate"),
    ("Wed", "17:30", "Vinyasa Yoga", "Tereza", "All levels"),
    ("Thu", "7:00", "Olympic Lifting", "Ondřej", "Advanced"),
    ("Thu", "18:30", "Core & Conditioning", "Klára", "Intermediate"),
    ("Fri", "6:00", "Friday Burn", "Adam", "Intermediate"),
    ("Fri", "17:00", "Stretch & Restore", "Tereza", "Beginner"),
    ("Sat", "9:00", "Team WOD", "Ondřej", "All levels"),
    ("Sat", "10:30", "Weekend Yoga", "Tereza", "Beginner")
  ]
  grid(3, anim: "stagger", hover: "lift") {
    for c in classes {
      if activeDay == "All" || c.0 == activeDay {
        card(
          c.2,
          "{c.0} · {c.1}\nCoach {c.3} · {c.4}",
          tag: c.4,
          fill: "alt"
        )
      }
    }
  }
}

fn membershipCards() -> Node = {
  let plans = [
    ("Basic", 790, 7900, "Gym floor access, 2 classes a week, App booking"),
    ("Unlimited", 1290, 12900, "Gym floor access, Unlimited classes, App booking, 1 coaching session a month"),
    ("Premium", 1990, 19900, "Everything in Unlimited, Weekly personal training, Towel and locker service")
  ]
  grid(3, anim: "stagger", hover: "lift") {
    for p in plans {
      let price = if activeBilling == "monthly" { p.1 } else { p.2 }
      let unit = if activeBilling == "monthly" { "month" } else { "year" }
      let popular = p.0 == "Unlimited"
      card(
        p.0,
        "Kč {price} per {unit}\n{p.3}",
        fill: if popular { "primary" } else { "alt" },
        tag: if popular { "Most popular" } else { "" },
        href: "#contact"
      )
    }
  }
}

fn galleryGrid() -> Node = {
  grid(4, anim: "stagger") {
    for i in 0..8 {
      let altTexts = [
        "The main training floor",
        "Kettlebells lined up",
        "A yoga class at sunset",
        "Barbells and plates",
        "The rowing machines",
        "A coach helping a member",
        "The stretching corner",
        "The front desk and café"
      ]
      img(
        "https://picsum.photos/seed/forge-g{i + 1}/1200/800",
        altTexts[i],
        ratio: "4/3",
        cls: "cursor-pointer hover:opacity-80",
        on: Msg.OpenGallery(i)
      )
    }
  }
}

page("/", "Forge Fitness Studio – strength, conditioning and yoga in Brno", desc: "Independent gym and group-class studio on Veveří in Brno: small classes, expert coaches, monthly or yearly membership and a free trial.") {
  navbar(
    "Forge Fitness",
    [
      ("Classes", "#classes"),
      ("Trainers", "#trainers"),
      ("Membership", "#membership"),
      ("Gallery", "#gallery"),
      ("Contact", "#contact")
    ],
    cta: ("Free trial", "#contact")
  )

  hero(
    "Train hard. Feel at home.",
    kicker: "Brno · Veveří 54 · since 2016",
    text: "Strength, conditioning and yoga classes in small groups, with coaches who know your name.",
    image: "https://picsum.photos/seed/forge-hero/1600/1000",
    alt: "Athletes training with kettlebells at Forge",
    buttons: [("See the schedule", "#classes"), ("Free trial", "#contact")],
    anim: "rise"
  )

  section("numbers", bg: "alt", anim: "rise") {
    grid(4, anim: "stagger") {
      stat(12, "Coaches")
      stat(45, "Classes a week")
      stat(2300, "Members")
      chip("6 a.m.", "First class")
    }
  }

  section("classes", "Classes this week", kicker: "Schedule", bg: "white", anim: "rise") {
    p("Book through the app or at the front desk. Max 12 people per class.")
    row {
      for day in ["All", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"] {
        button(day, style: if day == activeDay { "primary" } else { "ghost" }, on: Msg.FilterDay(day))
      }
    }
    classCards()
  }

  section("trainers", "Meet the team", kicker: "Coaches", bg: "alt", anim: "rise") {
    grid(4, anim: "stagger", hover: "lift") {
      for i in 1..5 {
        let coaches = [
          ("Adam Novotný", "Strength & conditioning", "Former rower who builds engines that last."),
          ("Klára Benešová", "Kettlebells & core", "Turns nervous beginners into confident lifters."),
          ("Tereza Malá", "Yoga & mobility", "Helps you move better so you can train longer."),
          ("Ondřej Černý", "Olympic lifting", "National-level lifter with an eye for technique.")
        ]
        card(
          coaches[i - 1].0,
          coaches[i - 1].2,
          image: "https://picsum.photos/seed/forge-coach-{i}/600/700",
          tag: coaches[i - 1].1,
          fill: "white"
        )
      }
    }
  }

  section("membership", "Pick your plan", kicker: "Membership", bg: "white", anim: "rise") {
    row {
      button("Monthly", style: if activeBilling == "monthly" { "primary" } else { "ghost" }, on: Msg.SwitchBilling("monthly"))
      button("Yearly", style: if activeBilling == "yearly" { "primary" } else { "ghost" }, on: Msg.SwitchBilling("yearly"))
    }
    membershipCards()
  }

  section("testimonials", "Members say", bg: "alt", anim: "rise") {
    grid(3, anim: "stagger") {
      quote("I came for the free trial and stayed for the people.", "Lenka M.")
      quote("Adam fixed my squat in two sessions after years of knee pain.", "Jakub S.")
      quote("The only gym where the 6 a.m. class feels like a party.", "Veronika D.")
    }
  }

  section("gallery", "Inside the studio", kicker: "Gallery", bg: "white", anim: "rise") {
    galleryGrid()
  }

  section("contact", "Come for a free trial", kicker: "Contact", bg: "alt", anim: "rise") {
    row {
      stack {
        p("Veveří 54, 602 00 Brno")
        link("Open in Google Maps", "https://maps.google.com/?q=Veveří+54,+Brno")
      }
      stack {
        link("+420 541 000 777", "tel:+420541000777")
        link("hello@forgefitness.cz", "mailto:hello@forgefitness.cz")
      }
    }
    p("Monday–Friday 6:00–22:00\nSaturday–Sunday 8:00–20:00")
    form(
      "Book your free trial",
      mailto: "hello@forgefitness.cz"
    ) {
      field("name", "Name", type: "text", req: true)
      field("email", "E-mail", type: "email", req: true)
      field("phone", "Phone", type: "tel")
      field("interested", "Interested in", type: "select", req: true, options: ["Free trial", "Membership", "Personal training"])
      field("message", "Message", type: "area", req: true)
    }
  }

  footer(
    text: "Forge Fitness Studio",
    contact: ["Veveří 54, 602 00 Brno", "+420 541 000 777", "hello@forgefitness.cz"],
    links: [
      ("Classes", "#classes"),
      ("Trainers", "#trainers"),
      ("Membership", "#membership"),
      ("Gallery", "#gallery"),
      ("Contact", "#contact")
    ],
    small: ["© 2026 Forge Fitness Studio"]
  )
}
