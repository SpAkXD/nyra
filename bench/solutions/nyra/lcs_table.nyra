fn sequence(seed: int, n: int) -> [int] {
    var out: [int] = []
    var x = seed
    for _ in 0..n {
        x = (x * 75 + 74) % 65537
        out.push(x % 4)
    }
    ret out
}

fn main() {
    let n = 1000
    let a = sequence(1, n)
    let b = sequence(2, n)
    var prev = [0].repeat(n + 1)
    for i in 1..n + 1 {
        var cur = [0].repeat(n + 1)
        let ai = a[i - 1]
        for j in 1..n + 1 {
            if ai == b[j - 1] {
                cur[j] = prev[j - 1] + 1
            } else if prev[j] >= cur[j - 1] {
                cur[j] = prev[j]
            } else {
                cur[j] = cur[j - 1]
            }
        }
        prev = cur
        if i % 250 == 0 {
            print(prev[i])
        }
    }
}
