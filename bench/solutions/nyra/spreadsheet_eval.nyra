struct Val {
    err: str
    v: int
}

struct Sheet {
    formulas: [str]
    cycle: [bool]
    vals: [Val]
    done: [bool]
}

struct Ref {
    col: int
    row: int
}

fn ok(v: int) -> Val = Val(err: "", v: v)
fn bad(e: str) -> Val = Val(err: e, v: 0)

fn valid(r: Ref) -> bool = r.col >= 0 && r.col < 4 && r.row >= 1 && r.row <= 5
fn index_of_ref(r: Ref) -> int = (r.row - 1) * 4 + r.col
fn cell_name(i: int) -> str = str("ABCD"[i % 4]) + "{i / 4 + 1}"

fn peek(cs: [char], pos: int) -> char = if pos < cs.len() { cs[pos] } else { ' ' }

// reads a cell name such as `B3` at pos
fn read_ref(cs: [char], inout pos: int) -> Ref {
    let col = cs[pos].code() - 'A'.code()
    pos += 1
    var row = 0
    while peek(cs, pos).is_digit() {
        row = row * 10 + cs[pos].code() - '0'.code()
        pos += 1
    }
    ret Ref(col: col, row: row)
}

// the cells a formula refers to (valid references only)
fn references(formula: str) -> [int] {
    let cs = formula.chars()
    var out: [int] = []
    var pos = 0
    while pos < cs.len() {
        if cs[pos].is_upper() && peek(cs, pos + 1).is_upper() {
            while peek(cs, pos).is_upper() { pos += 1 }
        } else if cs[pos].is_upper() {
            let a = read_ref(cs, inout pos)
            if peek(cs, pos) == ':' {
                pos += 1
                let b = read_ref(cs, inout pos)
                if valid(a) && valid(b) {
                    for r in a.row..b.row + 1 {
                        for c in a.col..b.col + 1 {
                            out.push(index_of_ref(Ref(col: c, row: r)))
                        }
                    }
                }
            } else if valid(a) {
                out.push(index_of_ref(a))
            }
        } else {
            pos += 1
        }
    }
    ret out
}

fn cell_value(inout sheet: Sheet, i: int) -> Val {
    if sheet.done[i] { ret sheet.vals[i] }
    let f = sheet.formulas[i]
    var result = ok(0)
    if sheet.cycle[i] {
        result = bad("#CYCLE")
    } else if f.starts_with("=") {
        let cs = f.slice(1, f.len()).chars()
        var pos = 0
        result = expr(inout sheet, cs, inout pos)
    } else if f != "" {
        result = ok(int(f))
    }
    sheet.vals[i] = result
    sheet.done[i] = true
    ret result
}

fn combine(op: char, a: Val, b: Val) -> Val {
    if a.err != "" { ret a }
    if b.err != "" { ret b }
    if op == '+' { ret ok(a.v + b.v) }
    if op == '-' { ret ok(a.v - b.v) }
    if op == '*' { ret ok(a.v * b.v) }
    if b.v == 0 { ret bad("#DIV0") }
    ret ok(a.v / b.v)
}

fn expr(inout sheet: Sheet, cs: [char], inout pos: int) -> Val {
    var acc = term(inout sheet, cs, inout pos)
    while peek(cs, pos) == '+' || peek(cs, pos) == '-' {
        let op = cs[pos]
        pos += 1
        let rhs = term(inout sheet, cs, inout pos)
        acc = combine(op, acc, rhs)
    }
    ret acc
}

fn term(inout sheet: Sheet, cs: [char], inout pos: int) -> Val {
    var acc = factor(inout sheet, cs, inout pos)
    while peek(cs, pos) == '*' || peek(cs, pos) == '/' {
        let op = cs[pos]
        pos += 1
        let rhs = factor(inout sheet, cs, inout pos)
        acc = combine(op, acc, rhs)
    }
    ret acc
}

fn factor(inout sheet: Sheet, cs: [char], inout pos: int) -> Val {
    let c = cs[pos]
    if c == '-' {
        pos += 1
        let inner = factor(inout sheet, cs, inout pos)
        ret combine('-', ok(0), inner)
    }
    if c == '(' {
        pos += 1
        let inner = expr(inout sheet, cs, inout pos)
        pos += 1 // ')'
        ret inner
    }
    if c.is_digit() {
        var n = 0
        while peek(cs, pos).is_digit() {
            n = n * 10 + cs[pos].code() - '0'.code()
            pos += 1
        }
        ret ok(n)
    }
    if peek(cs, pos + 1).is_upper() {
        var name = ""
        while peek(cs, pos).is_upper() {
            name += str(cs[pos])
            pos += 1
        }
        pos += 1 // '('
        let a = read_ref(cs, inout pos)
        pos += 1 // ':'
        let b = read_ref(cs, inout pos)
        pos += 1 // ')'
        if !valid(a) || !valid(b) { ret bad("#REF") }
        var total = 0
        var best = 0
        var first = true
        for r in a.row..b.row + 1 {
            for col in a.col..b.col + 1 {
                let v = cell_value(inout sheet, index_of_ref(Ref(col: col, row: r)))
                if v.err != "" { ret v }
                total += v.v
                if first || v.v > best { best = v.v }
                first = false
            }
        }
        ret if name == "SUM" { ok(total) } else { ok(best) }
    }
    let r = read_ref(cs, inout pos)
    if !valid(r) { ret bad("#REF") }
    ret cell_value(inout sheet, index_of_ref(r))
}

// cells reachable from `from` in one or more steps
fn reachable(edges: [[int]], from: int) -> [bool] {
    var seen = [false].repeat(edges.len())
    var todo = edges[from]
    while todo.len() > 0 {
        let n = todo.pop()
        if !seen[n] {
            seen[n] = true
            todo = todo + edges[n]
        }
    }
    ret seen
}

fn main() {
    let filled = "A1 10; B1 =A1*2; C1 =B1+A2; D1 =SUM(A1:C1); A2 3; B2 =A2-B1/4; D2 =MAX(A1:C2)*(C2+2); A3 =B3+1; B3 =C3; C3 =A3*0; D3 =-C3; A4 =10/(A2-3); B4 =A4+1; C4 =MAX(A1:B2)+D4; D4 =E1+1; A5 =SUM(A1:D2)-(A1+B1)*-2; B5 =B1/0+D4; C5 =SUM(C4:C5); D5 =D4*0+B4"
    var formulas = [""].repeat(20)
    for entry in filled.split("; ") {
        let parts = entry.split(" ")
        var p = 0
        let r = read_ref(parts[0].chars(), inout p)
        formulas[index_of_ref(r)] = parts[1]
    }
    var edges: [[int]] = []
    for f in formulas { edges.push(references(f)) }
    var on_cycle = [false].repeat(20)
    for i in 0..20 {
        on_cycle[i] = reachable(edges, i)[i]
    }
    var cycle = [false].repeat(20)
    for i in 0..20 {
        let seen = reachable(edges, i)
        var hit = on_cycle[i]
        for j in 0..20 {
            if seen[j] && on_cycle[j] { hit = true }
        }
        cycle[i] = hit
    }
    var sheet = Sheet(formulas: formulas, cycle: cycle, vals: [ok(0)].repeat(20), done: [false].repeat(20))
    for i in 0..20 {
        if formulas[i] != "" {
            let v = cell_value(inout sheet, i)
            let shown = if v.err != "" { v.err } else { "{v.v}" }
            print("{cell_name(i)} = {shown}")
        }
    }
}
