// a passage from `a` in direction `dir` to `b`; it also leads back from `b` the opposite way
struct Passage {
    a: str
    dir: str
    b: str
    locked: bool
}

let opposite = ["north": "south", "south": "north", "east": "west", "west": "east", "down": "up", "up": "down"]
let dirs = ["down", "east", "north", "south", "up", "west"]
var ps = [
    Passage(a: "hall", dir: "north", b: "library", locked: false),
    Passage(a: "hall", dir: "east", b: "kitchen", locked: false),
    Passage(a: "kitchen", dir: "north", b: "pantry", locked: false),
    Passage(a: "kitchen", dir: "down", b: "cellar", locked: false),
    Passage(a: "library", dir: "east", b: "study", locked: true),
    Passage(a: "study", dir: "south", b: "pantry", locked: false),
]
// where each thing is: a room, or "player"
var place = ["lamp": "hall", "key": "pantry", "rope": "pantry", "book": "study", "coin": "cellar"]
var room = "hall"
var visited: [str] = []

// the passage that leaves `from` in direction d, or -1
fn exit_of(from: str, d: str) -> int {
    for i, p in ps {
        if (p.a == from && p.dir == d) || (p.b == from && opposite[p.dir] == d) { ret i }
    }
    ret -1
}

fn names_at(spot: str) -> [str] {
    var out = place.keys().filter(n => place[n] == spot)
    out.sort()
    ret out
}

fn has(name: str, spot: str) -> bool = place.get(name, "") == spot

let commands = "look; go north; unlock east; go east; go south; take lamp; go west; go east; go down; take coin; take coin; go up; go north; take key; drop coin; take key; inventory; go west; look; go north; unlock west; unlock west; go west; unlock east; drop lamp; go south; go east; go down; look; unlock up; take rope; go north; take coin; go south; go west; drop coin; inventory"
for command in commands.split("; ") {
    let words = command.split(" ")
    let op = words[0]
    if op == "go" {
        let d = words[1]
        let e = exit_of(room, d)
        if e < 0 {
            print("no exit {d}")
        } else if ps[e].locked {
            print("the door is locked")
        } else {
            let to = if ps[e].a == room { ps[e].b } else { ps[e].a }
            if to == "cellar" && !has("lamp", "player") {
                print("too dark to enter")
            } else {
                room = to
                if room != "hall" && !visited.contains(room) { visited.push(room) }
                print("you are in {room}")
            }
        }
    } else if op == "take" {
        let x = words[1]
        if !has(x, room) {
            print("no {x} here")
        } else if names_at("player").len() >= 2 {
            print("hands full")
        } else {
            place[x] = "player"
            print("taken {x}")
        }
    } else if op == "drop" {
        let x = words[1]
        if !has(x, "player") {
            print("you have no {x}")
        } else {
            place[x] = room
            print("dropped {x}")
        }
    } else if op == "unlock" {
        let d = words[1]
        let e = exit_of(room, d)
        if e < 0 {
            print("no exit {d}")
        } else if !ps[e].locked {
            print("nothing to unlock")
        } else if !has("key", "player") {
            print("you need the key")
        } else {
            ps[e].locked = false
            print("unlocked")
        }
    } else if op == "look" {
        let here = names_at(room)
        let items = if here.len() == 0 { "none" } else { here.join(", ") }
        let exits = dirs.filter(d => exit_of(room, d) >= 0)
        print("{room} | items: {items} | exits: {exits.join(", ")}")
    } else if op == "inventory" {
        let carried = names_at("player")
        print("carrying: {if carried.len() == 0 { "nothing" } else { carried.join(", ") }}")
    }
}
var score = 10 * visited.len()
if has("coin", "hall") { score += 25 }
print("score {score}")
