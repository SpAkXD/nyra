fn roman(n: int) -> str {
    let values = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
    let symbols = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
    var s = ""
    var x = n
    for i, v in values {
        while x >= v {
            s += symbols[i]
            x -= v
        }
    }
    ret s
}

for n in [4, 9, 14, 40, 90, 400, 1994, 2024] { print(roman(n)) }
