fn survivor(n: int, k: int) -> int {
    var people: [int] = []
    for i in 1..n + 1 {
        people.push(i)
    }
    var index = 0
    while people.len() > 1 {
        index = (index + k - 1) % people.len()
        people.remove(index)
    }
    ret people[0]
}

fn main() {
    print(survivor(7, 3))
    print(survivor(41, 3))
    print(survivor(10, 2))
}
