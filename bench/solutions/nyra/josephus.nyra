fn survivor(n: int, k: int) -> int {
    var people = [i for i in 1..n + 1]
    var index = 0
    while people.len() > 1 {
        index = (index + k - 1) % people.len()
        people.remove(index)
    }
    ret people[0]
}
ex survivor(1, 3) == 1, survivor(7, 3) == 4, survivor(5, 2) == 3

print(survivor(7, 3))
print(survivor(41, 3))
print(survivor(10, 2))
