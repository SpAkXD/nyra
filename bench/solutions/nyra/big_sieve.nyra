let limit = 2000000
var is_prime = [true].repeat(limit)
is_prime[0] = false
is_prime[1] = false
var i = 2
while i * i < limit {
    if is_prime[i] {
        for j in i * i..limit step i { is_prime[j] = false }
    }
    i += 1
}
let primes = [n for n in 2..limit if is_prime[n]]
print(primes.len())
print(primes.sum())
print(primes.max())
print(primes.count(n => n + 2 < limit && is_prime[n + 2]))
