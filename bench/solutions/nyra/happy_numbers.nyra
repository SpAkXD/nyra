fn next(n: int) -> int = str(n).chars().map(c => int(str(c))).map(d => d * d).sum()

// a slow and a fast walker: they meet on a cycle, unless the fast one reaches 1 first
fn is_happy(n: int) -> bool {
    var slow = n
    var fast = next(n)
    while fast != 1 && slow != fast {
        slow = next(slow)
        fast = next(next(fast))
    }
    ret fast == 1
}
ex is_happy(19), is_happy(7), !is_happy(4)

var found = 0
var n = 1
while found < 10 {
    if is_happy(n) {
        print(n)
        found += 1
    }
    n += 1
}
