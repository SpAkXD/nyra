struct Job {
    name: str
    arrival: int
    need: int
    left: int
    joined: bool
    finish: int
}

fn job(name: str, arrival: int, need: int) -> Job = Job(name: name, arrival: arrival, need: need, left: need, joined: false, finish: 0)

let quantum = 3
var jobs = [job("A", 0, 5), job("B", 1, 3), job("C", 3, 8), job("D", 11, 2), job("E", 30, 4), job("F", 30, 1)]
var queue: [int] = []
var t = 0
var prev = -1           // the job of the previous slice
var idle = false        // has the CPU been idle since the previous slice
var pending = -1        // the job of the slice that just ended, if it is not finished
while true {
    for i, jb in jobs {
        if !jb.joined && jb.arrival <= t {
            jobs[i].joined = true
            queue.push(i)
        }
    }
    if pending >= 0 {
        queue.push(pending)
        pending = -1
    }
    if queue.len() == 0 {
        let upcoming = jobs.filter(jb => !jb.joined).map(jb => jb.arrival)
        if upcoming.len() == 0 { break }
        print("{t}-{upcoming.min()} idle")
        t = upcoming.min()
        idle = true
        continue
    }
    let j = queue.remove(0)
    if prev >= 0 && prev != j && !idle {
        print("{t}-{t + 1} switch")
        t += 1
    }
    let run = min(jobs[j].left, quantum)
    print("{t}-{t + run} {jobs[j].name}")
    t += run
    jobs[j].left -= run
    if jobs[j].left == 0 { jobs[j].finish = t } else { pending = j }
    prev = j
    idle = false
}
for jb in jobs {
    print("{jb.name} finish {jb.finish} wait {jb.finish - jb.arrival - jb.need}")
}
