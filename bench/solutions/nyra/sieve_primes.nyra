fn main() {
    let limit = 60
    var is_prime = [true].repeat(limit)
    is_prime[0] = false
    is_prime[1] = false
    for i in 2..limit {
        if is_prime[i] {
            var m = i * i
            while m < limit {
                is_prime[m] = false
                m += i
            }
        }
    }
    for i in 0..limit {
        if is_prime[i] {
            print(i)
        }
    }
}
