fn main() {
    var term = "2333111"
    for step in 1..41 {
        let digits = term.chars()
        var parts: [str] = []
        var i = 0
        let n = digits.len()
        while i < n {
            let c = digits[i]
            var j = i
            while j < n && digits[j] == c {
                j += 1
            }
            parts.push(str(j - i))
            parts.push(str(c))
            i = j
        }
        term = parts.join("")
        if step % 5 == 0 {
            print(step, term.len())
        }
    }
    var ones = 0
    var twos = 0
    var threes = 0
    for c in term {
        if c == '1' { ones += 1 } else if c == '2' { twos += 1 } else if c == '3' { threes += 1 }
    }
    print(ones, twos, threes)
}
