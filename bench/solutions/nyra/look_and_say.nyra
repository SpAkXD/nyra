var term = "2333111"
for step in 1..41 {
    let digits = term.chars()
    var parts: [str] = []
    var i = 0
    while i < digits.len() {
        var j = i
        while j < digits.len() && digits[j] == digits[i] { j += 1 }
        parts.push("{j - i}{digits[i]}")
        i = j
    }
    term = parts.join("")
    if step % 5 == 0 { print(step, term.len()) }
}
print(term.count(c => c == '1'), term.count(c => c == '2'), term.count(c => c == '3'))
