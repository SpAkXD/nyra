// recursive descent over the characters of one expression; a division or remainder by zero sets `bad`
var cs: [char] = []
var pos = 0
var bad = false

fn skip() {
    while pos < cs.len() && cs[pos] == ' ' { pos += 1 }
}

// the next non-space character, or ' ' at the end
fn peek() -> char {
    skip()
    ret if pos < cs.len() { cs[pos] } else { ' ' }
}

// moves past the next non-space character
fn eat() {
    skip()
    pos += 1
}

fn sum() -> int {
    var v = product()
    while peek() == '+' || peek() == '-' {
        let op = peek()
        eat()
        let r = product()
        v = if op == '+' { v + r } else { v - r }
    }
    ret v
}

fn product() -> int {
    var v = unary()
    while peek() == '*' || peek() == '/' || peek() == '%' {
        let op = peek()
        eat()
        let r = unary()
        if op == '*' {
            v *= r
        } else if r == 0 {
            v = 0
            bad = true
        } else if op == '/' {
            v /= r
        } else {
            v %= r
        }
    }
    ret v
}

fn unary() -> int {
    if peek() != '-' { ret power() }
    eat()
    ret -unary()
}

fn power() -> int {
    let base = atom()
    if peek() != '^' { ret base }
    eat()
    var r = 1
    for _ in 0..power() { r *= base }
    ret r
}

fn atom() -> int {
    if peek() == '(' {
        eat()
        let v = sum()
        eat()          // the `)`
        ret v
    }
    skip()
    var n = 0
    while pos < cs.len() && cs[pos].is_digit() {
        n = n * 10 + cs[pos].code() - '0'.code()
        pos += 1
    }
    ret n
}

let exprs = [
    "1 + 2 * 3 - 4 / 2",
    "10 - 4 - 3",
    "2 ^ 3 ^ 2",
    "-2 ^ 2",
    "(-2) ^ 2",
    "2 * (3 + 4) ^ 2",
    "100 / 7 % 4",
    "- - 3",
    "8/3*3+8%3",
    "((15 % 4) ^ 2 - -3) * 2",
    "0 * (5 / (2 - 2))",
    "0^0 + 2^10 - 1000",
    "-(3 - 10) * -2 ^ 3",
    "7 - (2 - (3 - (4 - 5)))",
    "2 ^ (1 + 1) ^ 3",
    "17 % 5 ^ 2 / 3",
    "(1 + 2) * (3 % (4 - 4)) + 1",
    "-3 ^ 2 * -(1 + 1) ^ 2",
]
for e in exprs {
    cs = e.chars()
    pos = 0
    bad = false
    let v = sum()
    let shown = if bad { "division by zero" } else { str(v) }
    print("{e} = {shown}")
}
