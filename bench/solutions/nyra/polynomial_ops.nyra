// a polynomial is its coefficients by degree: [c0, c1, c2, ...], without trailing zeros

fn trimmed(p: [int]) -> [int] {
    var q = p
    while q.len() > 0 && q[q.len() - 1] == 0 { q.pop() }
    ret q
}

// adds c x^e to p
fn add_term(inout p: [int], c: int, e: int) {
    while p.len() <= e { p.push(0) }
    p[e] += c
}

// one term without its sign: `3x^2`, `x`, `5`
fn parse_term(inout p: [int], term: str, sign: int) {
    let x = term.index_of("x")
    if x < 0 {
        add_term(inout p, sign * int(term), 0)
        ret
    }
    let before = term.slice(0, x)
    let c = if before == "" { 1 } else { int(before) }
    let e = if x + 1 < term.len() { int(term.slice(x + 2, term.len())) } else { 1 }
    add_term(inout p, sign * c, e)
}

fn parse(text: str) -> [int] {
    var p: [int] = []
    let parts = text.split(" ")
    let negative = parts[0].starts_with("-")
    parse_term(inout p, if negative { parts[0].slice(1, parts[0].len()) } else { parts[0] }, if negative { -1 } else { 1 })
    for i in 1..parts.len() step 2 {
        parse_term(inout p, parts[i + 1], if parts[i] == "-" { -1 } else { 1 })
    }
    ret trimmed(p)
}
ex parse("2x + 3 - x") == [3, 1], parse("-x^2 + x^2") == [], parse("x^3 - 4") == [-4, 0, 0, 1]

fn add(a: [int], b: [int]) -> [int] {
    var r = a
    for e, c in b { add_term(inout r, c, e) }
    ret trimmed(r)
}

fn sub(a: [int], b: [int]) -> [int] = add(a, b.map(c => -c))

fn mul(a: [int], b: [int]) -> [int] {
    var r: [int] = []
    for i, x in a {
        for j, y in b { add_term(inout r, x * y, i + j) }
    }
    ret trimmed(r)
}
ex mul([1, 1], [1, 1]) == [1, 2, 1], mul([], [1]) == []

fn derivative(a: [int]) -> [int] {
    var r: [int] = []
    for e in 1..a.len() { add_term(inout r, e * a[e], e - 1) }
    ret trimmed(r)
}

// a with b substituted for x (Horner)
fn compose(a: [int], b: [int]) -> [int] {
    var r: [int] = []
    for e in a.len() - 1..-1 step -1 { r = add(mul(r, b), [a[e]]) }
    ret r
}

fn value_at(a: [int], x: int) -> int = a.reversed().fold(0, (r, c) => r * x + c)
ex value_at([1, 2, 3], 2) == 17, value_at([], 5) == 0

fn show(a: [int]) -> str {
    var out = ""
    for e in a.len() - 1..-1 step -1 {
        let c = a[e]
        if c == 0 { continue }
        if out == "" {
            if c < 0 { out += "-" }
        } else {
            out += if c < 0 { " - " } else { " + " }
        }
        let m = abs(c)
        if e == 0 {
            out += str(m)
        } else {
            if m != 1 { out += str(m) }
            out += if e == 1 { "x" } else { "x^{e}" }
        }
    }
    ret if out == "" { "0" } else { out }
}
ex show([-1, 0, 3]) == "3x^2 - 1", show([0, 1]) == "x", show([]) == "0"

let p = parse("2x + 3 - x + x^2 - 4")
let q = parse("-x^3 + 2x - 1 + x^3 + x^2 + x^10 - x^10")
let r = parse("5 - 3x^2")
let pq = mul(p, q)
let qr = compose(q, r)
print("P = {show(p)}")
print("Q = {show(q)}")
print("R = {show(r)}")
print("P + Q = {show(add(p, q))}")
print("P - R = {show(sub(p, r))}")
print("P * Q = {show(pq)}")
print("(P * Q)' = {show(derivative(pq))}")
print("Q(R) = {show(qr)}")
print("R(P) - R = {show(sub(compose(r, p), r))}")
print("P - P = {show(sub(p, p))}")
print("P(-3) = {value_at(p, -3)}")
print("Q(R)(2) = {value_at(qr, 2)}")
