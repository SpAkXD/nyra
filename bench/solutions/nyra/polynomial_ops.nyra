// a polynomial is its coefficients by degree: [c0, c1, c2, ...], without trailing zeros

fn abs(x: int) -> int = if x < 0 { -x } else { x }

fn trimmed(p: [int]) -> [int] {
    var q = p
    while q.len() > 0 && q[q.len() - 1] == 0 { q.pop() }
    ret q
}

// adds c x^e to p
fn add_term(inout p: [int], c: int, e: int) {
    while p.len() <= e { p.push(0) }
    p[e] += c
}

// one term without its sign: `3x^2`, `x`, `5`
fn parse_term(inout p: [int], term: str, sign: int) {
    let x = term.index_of("x")
    if x < 0 {
        add_term(inout p, sign * int(term), 0)
        ret
    }
    let before = term.slice(0, x)
    let c = if before == "" { 1 } else { int(before) }
    let e = if x + 1 < term.len() { int(term.slice(x + 2, term.len())) } else { 1 }
    add_term(inout p, sign * c, e)
}

fn parse(text: str) -> [int] {
    var p: [int] = []
    let parts = text.split(" ")
    var first = parts[0]
    var sign = 1
    if first.starts_with("-") {
        sign = -1
        first = first.slice(1, first.len())
    }
    parse_term(inout p, first, sign)
    var i = 1
    while i < parts.len() {
        let s = if parts[i] == "-" { -1 } else { 1 }
        parse_term(inout p, parts[i + 1], s)
        i += 2
    }
    ret trimmed(p)
}

fn add(a: [int], b: [int]) -> [int] {
    var r = a
    for e in 0..b.len() { add_term(inout r, b[e], e) }
    ret trimmed(r)
}

fn scaled(a: [int], k: int) -> [int] {
    var r = a
    for e in 0..r.len() { r[e] *= k }
    ret trimmed(r)
}

fn sub(a: [int], b: [int]) -> [int] = add(a, scaled(b, -1))

fn mul(a: [int], b: [int]) -> [int] {
    var r: [int] = []
    for i in 0..a.len() {
        for j in 0..b.len() {
            add_term(inout r, a[i] * b[j], i + j)
        }
    }
    ret trimmed(r)
}

fn derivative(a: [int]) -> [int] {
    var r: [int] = []
    for e in 1..a.len() { add_term(inout r, e * a[e], e - 1) }
    ret trimmed(r)
}

// a with b substituted for x (Horner)
fn compose(a: [int], b: [int]) -> [int] {
    var r: [int] = []
    var e = a.len() - 1
    while e >= 0 {
        r = add(mul(r, b), [a[e]])
        e -= 1
    }
    ret r
}

fn value_at(a: [int], x: int) -> int {
    var r = 0
    var e = a.len() - 1
    while e >= 0 {
        r = r * x + a[e]
        e -= 1
    }
    ret r
}

fn show(a: [int]) -> str {
    var out = ""
    var e = a.len() - 1
    while e >= 0 {
        let c = a[e]
        if c != 0 {
            if out == "" {
                if c < 0 { out += "-" }
            } else {
                out += if c < 0 { " - " } else { " + " }
            }
            let m = abs(c)
            if e == 0 {
                out += str(m)
            } else {
                if m != 1 { out += str(m) }
                out += if e == 1 { "x" } else { "x^{e}" }
            }
        }
        e -= 1
    }
    ret if out == "" { "0" } else { out }
}

fn main() {
    let p = parse("2x + 3 - x + x^2 - 4")
    let q = parse("-x^3 + 2x - 1 + x^3 + x^2 + x^10 - x^10")
    let r = parse("5 - 3x^2")
    let pq = mul(p, q)
    let qr = compose(q, r)
    print("P = {show(p)}")
    print("Q = {show(q)}")
    print("R = {show(r)}")
    print("P + Q = {show(add(p, q))}")
    print("P - R = {show(sub(p, r))}")
    print("P * Q = {show(pq)}")
    print("(P * Q)' = {show(derivative(pq))}")
    print("Q(R) = {show(qr)}")
    print("R(P) - R = {show(sub(compose(r, p), r))}")
    print("P - P = {show(sub(p, p))}")
    print("P(-3) = {value_at(p, -3)}")
    print("Q(R)(2) = {value_at(qr, 2)}")
}
