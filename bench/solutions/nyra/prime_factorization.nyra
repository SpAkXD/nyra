fn factorization(n: int) -> str {
    var parts: [str] = []
    var rest = n
    var p = 2
    while p * p <= rest {
        var exponent = 0
        while rest % p == 0 {
            rest /= p
            exponent += 1
        }
        if exponent == 1 { parts.push("{p}") } else if exponent > 1 { parts.push("{p}^{exponent}") }
        p += 1
    }
    if rest > 1 { parts.push("{rest}") }
    ret "{n} = {parts.join(" * ")}"
}
ex factorization(12) == "12 = 2^2 * 3", factorization(13) == "13 = 13"

for n in [360, 97, 1001, 65536, 999999] { print(factorization(n)) }
