var pending: [str] = []   // unchanged lines not printed yet

// prints the run of unchanged lines collected so far, then empties it
fn flush() {
    if pending.len() >= 3 {
        print("= ({pending.len()} unchanged)")
    } else {
        for line in pending { print("= {line}") }
    }
    pending = []
}

fn diff(a: [str], b: [str]) {
    let n = a.len()
    let m = b.len()
    // lcs[i][j]: the length of the longest common subsequence of a[i..] and b[j..]
    var lcs = [[0].repeat(m + 1)].repeat(n + 1)
    for i in n - 1..-1 step -1 {
        for j in m - 1..-1 step -1 {
            lcs[i][j] = if a[i] == b[j] { lcs[i + 1][j + 1] + 1 } else { max(lcs[i + 1][j], lcs[i][j + 1]) }
        }
    }
    var x = 0
    var y = 0
    var ins = 0
    var del = 0
    var same = 0
    while x < n || y < m {
        if x < n && y < m && a[x] == b[y] {
            pending.push(a[x])
            same += 1
            x += 1
            y += 1
        } else if x < n && (y == m || lcs[x + 1][y] >= lcs[x][y + 1]) {
            flush()
            print("- {a[x]}")
            del += 1
            x += 1
        } else {
            flush()
            print("+ {b[y]}")
            ins += 1
            y += 1
        }
    }
    flush()
    print("summary: +{ins} -{del} ={same}")
}

print("diff 1")
diff(
    ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa"],
    ["alpha", "gamma", "delta", "beta", "epsilon", "zeta", "eta", "lambda", "theta", "kappa", "mu"],
)
print("diff 2")
diff(
    ["x = 1", "y = 2", "print(x)", "print(y)", "z = x + y", "print(z)"],
    ["y = 2", "x = 1", "print(x)", "z = x + y", "print(z)", "print(y)"],
)
