// prints the run of unchanged lines collected so far, then empties it
fn flush(inout run: [str]) {
    if run.len() >= 3 {
        print("= ({run.len()} unchanged)")
    } else {
        for line in run { print("= {line}") }
    }
    run = []
}

fn diff(a: [str], b: [str]) {
    let n = a.len()
    let m = b.len()
    // lcs[i][j] is L(i, j)
    var lcs = [[0].repeat(m + 1)].repeat(n + 1)
    var i = n - 1
    while i >= 0 {
        var j = m - 1
        while j >= 0 {
            if a[i] == b[j] {
                lcs[i][j] = lcs[i + 1][j + 1] + 1
            } else if lcs[i + 1][j] >= lcs[i][j + 1] {
                lcs[i][j] = lcs[i + 1][j]
            } else {
                lcs[i][j] = lcs[i][j + 1]
            }
            j -= 1
        }
        i -= 1
    }
    var x = 0
    var y = 0
    var run: [str] = []
    var ins = 0
    var del = 0
    var same = 0
    while x < n || y < m {
        if x < n && y < m && a[x] == b[y] {
            run.push(a[x])
            same += 1
            x += 1
            y += 1
        } else if x < n && (y == m || lcs[x + 1][y] >= lcs[x][y + 1]) {
            flush(inout run)
            print("- {a[x]}")
            del += 1
            x += 1
        } else {
            flush(inout run)
            print("+ {b[y]}")
            ins += 1
            y += 1
        }
    }
    flush(inout run)
    print("summary: +{ins} -{del} ={same}")
}

fn main() {
    print("diff 1")
    diff(
        ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa"],
        ["alpha", "gamma", "delta", "beta", "epsilon", "zeta", "eta", "lambda", "theta", "kappa", "mu"],
    )
    print("diff 2")
    diff(
        ["x = 1", "y = 2", "print(x)", "print(y)", "z = x + y", "print(z)"],
        ["y = 2", "x = 1", "print(x)", "z = x + y", "print(z)", "print(y)"],
    )
}
