let n = 120
let a = [[(i * 31 + j * 17 + 7) % 100 for j in 0..n] for i in 0..n]
let b = [[(i * 13 + j * 29 + 3) % 100 for j in 0..n] for i in 0..n]
var c = [[0].repeat(n)].repeat(n)
for i in 0..n {
    for j in 0..n {
        var s = 0
        for k in 0..n { s += a[i][k] * b[k][j] }
        c[i][j] = s
    }
}
print([c[i][i] for i in 0..n].sum())
print(c.map(row => row.sum()).sum())
print(c[0][n - 1])
print(c[n - 1][0])
