// the index of the line after the label `name`
fn target(lines: [str], name: str) -> int = lines.index_of(name + ":") + 1

fn needs(op: str) -> int {
    if op == "pop" || op == "dup" || op == "print" || op == "jz" { ret 1 }
    if op == "swap" || op == "over" || op == "add" || op == "sub" || op == "mul" || op == "div" || op == "mod" {
        ret 2
    }
    ret 0
}

fn run(lines: [str]) {
    var stack: [int] = []
    var calls: [int] = []
    var pc = 0
    var steps = 0
    while pc < lines.len() {
        let text = lines[pc]
        if text.ends_with(":") {
            pc += 1
            continue
        }
        if steps == 100 {
            print("error: step limit")
            break
        }
        steps += 1
        let w = text.split(" ")
        let op = w[0]
        let n = pc + 1
        if stack.len() < needs(op) {
            print("error at line {n}: stack underflow")
            break
        }
        pc += 1
        if op == "push" {
            stack.push(int(w[1]))
        } else if op == "pop" {
            stack.pop()
        } else if op == "dup" {
            stack.push(stack[stack.len() - 1])
        } else if op == "swap" {
            let b = stack.pop()
            let a = stack.pop()
            stack.push(b)
            stack.push(a)
        } else if op == "over" {
            stack.push(stack[stack.len() - 2])
        } else if op == "add" || op == "sub" || op == "mul" || op == "div" || op == "mod" {
            let b = stack[stack.len() - 1]
            let a = stack[stack.len() - 2]
            if (op == "div" || op == "mod") && b == 0 {
                print("error at line {n}: division by zero")
                break
            }
            stack.pop()
            stack.pop()
            if op == "add" {
                stack.push(a + b)
            } else if op == "sub" {
                stack.push(a - b)
            } else if op == "mul" {
                stack.push(a * b)
            } else if op == "div" {
                stack.push(a / b)
            } else {
                stack.push(a % b)
            }
        } else if op == "print" {
            print(stack.pop())
        } else if op == "jmp" {
            pc = target(lines, w[1])
        } else if op == "jz" {
            if stack.pop() == 0 { pc = target(lines, w[1]) }
        } else if op == "call" {
            calls.push(pc)
            pc = target(lines, w[1])
        } else if op == "ret" {
            if calls.len() == 0 {
                print("error at line {n}: return without call")
                break
            }
            pc = calls.pop()
        } else if op == "halt" {
            break
        }
    }
    if stack.len() == 0 {
        print("stack: empty")
    } else {
        var parts: [str] = []
        for v in stack { parts.push("{v}") }
        print("stack: " + parts.join(" "))
    }
}

fn main() {
    let programs = [
        ["push 9875", "call digits", "print", "push 406", "call digits", "print", "halt", "digits:", "push 0",
         "loop:", "over", "jz done", "over", "push 10", "mod", "add", "swap", "push 10", "div", "swap",
         "jmp loop", "done:", "swap", "pop", "ret"],
        ["push 5", "push 3", "sub", "dup", "print", "push 7", "swap", "sub", "print", "push -4", "ret", "print"],
        ["push 3", "top:", "dup", "print", "push 2", "mul", "jmp top"],
        ["push 6", "push 4", "call f", "print", "f:", "over", "over", "mod", "jz g", "push 0", "div", "g:", "ret"],
        ["push 1", "push 2", "swap", "over", "add", "add", "mul", "push 8"],
    ]
    for k in 0..programs.len() {
        print("program {k + 1}")
        run(programs[k])
    }
}
