// how many values an instruction needs on the stack
let arity = ["pop": 1, "dup": 1, "print": 1, "jz": 1, "swap": 2, "over": 2, "add": 2, "sub": 2, "mul": 2, "div": 2, "mod": 2]
let arithmetic = ["add", "sub", "mul", "div", "mod"]

// the index of the line after the label `name`
fn target(lines: [str], name: str) -> int = lines.index_of(name + ":") + 1

fn run(lines: [str]) {
    var stack: [int] = []
    var calls: [int] = []
    var pc = 0
    var steps = 0
    while pc < lines.len() {
        let text = lines[pc]
        if text.ends_with(":") {
            pc += 1
            continue
        }
        if steps == 100 {
            print("error: step limit")
            break
        }
        steps += 1
        let w = text.split(" ")
        let op = w[0]
        let n = pc + 1
        if stack.len() < arity.get(op, 0) {
            print("error at line {n}: stack underflow")
            break
        }
        pc += 1
        if op == "push" {
            stack.push(int(w[1]))
        } else if op == "pop" {
            stack.pop()
        } else if op == "dup" {
            stack.push(stack[stack.len() - 1])
        } else if op == "swap" {
            stack.swap(stack.len() - 1, stack.len() - 2)
        } else if op == "over" {
            stack.push(stack[stack.len() - 2])
        } else if arithmetic.contains(op) {
            let b = stack[stack.len() - 1]
            let a = stack[stack.len() - 2]
            if (op == "div" || op == "mod") && b == 0 {
                print("error at line {n}: division by zero")
                break
            }
            stack.pop()
            stack.pop()
            stack.push(if op == "add" { a + b } else if op == "sub" { a - b } else if op == "mul" { a * b } else if op == "div" { a / b } else { a % b })
        } else if op == "print" {
            print(stack.pop())
        } else if op == "jmp" {
            pc = target(lines, w[1])
        } else if op == "jz" {
            if stack.pop() == 0 { pc = target(lines, w[1]) }
        } else if op == "call" {
            calls.push(pc)
            pc = target(lines, w[1])
        } else if op == "ret" {
            if calls.len() == 0 {
                print("error at line {n}: return without call")
                break
            }
            pc = calls.pop()
        } else if op == "halt" {
            break
        }
    }
    print(if stack.len() == 0 { "stack: empty" } else { "stack: " + stack.map(v => str(v)).join(" ") })
}

let programs = [
    ["push 9875", "call digits", "print", "push 406", "call digits", "print", "halt", "digits:", "push 0",
     "loop:", "over", "jz done", "over", "push 10", "mod", "add", "swap", "push 10", "div", "swap",
     "jmp loop", "done:", "swap", "pop", "ret"],
    ["push 5", "push 3", "sub", "dup", "print", "push 7", "swap", "sub", "print", "push -4", "ret", "print"],
    ["push 3", "top:", "dup", "print", "push 2", "mul", "jmp top"],
    ["push 6", "push 4", "call f", "print", "f:", "over", "over", "mod", "jz g", "push 0", "div", "g:", "ret"],
    ["push 1", "push 2", "swap", "over", "add", "add", "mul", "push 8"],
]
for k, program in programs {
    print("program {k + 1}")
    run(program)
}
