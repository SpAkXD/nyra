// ages: 0 is a dead cell
let start = ["#......#", "..##....", ".#..#...", "..##....", "........", "#.....##"]
let rows = start.len()
let cols = start[0].len()
var age = [[if c == '#' { 1 } else { 0 } for c in row] for row in start]

fn neighbours(r: int, c: int) -> int {
    var n = 0
    for dr in -1..2 {
        for dc in -1..2 {
            if (dr != 0 || dc != 0) && age[(r + dr + rows) % rows][(c + dc + cols) % cols] > 0 { n += 1 }
        }
    }
    ret n
}

fn step() {
    var next = age
    for r in 0..rows {
        for c in 0..cols {
            let n = neighbours(r, c)
            let a = age[r][c]
            if a == 0 {
                next[r][c] = if n == 3 { 1 } else { 0 }
            } else if (n == 2 || n == 3) && a + 1 < 5 {
                next[r][c] = a + 1
            } else {
                next[r][c] = 0
            }
        }
    }
    age = next
}

for gen in 1..8 {
    step()
    let alive = age.map(row => row.count(a => a > 0)).sum()
    let oldest = age.map(row => row.max()).max()
    print("gen {gen}: {alive} alive, oldest {oldest}")
}
for row in age {
    print([if a > 0 { str(a) } else { "." } for a in row].join(""))
}
