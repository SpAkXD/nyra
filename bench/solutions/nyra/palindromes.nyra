fn is_palindrome(word: str) -> bool {
    var i = 0
    var j = word.len() - 1
    while i < j {
        if word[i] != word[j] {
            ret false
        }
        i += 1
        j -= 1
    }
    ret true
}

fn main() {
    for word in ["level", "hello", "racecar", "robot", "a", "abba"] {
        print(if is_palindrome(word) { "yes" } else { "no" })
    }
}
