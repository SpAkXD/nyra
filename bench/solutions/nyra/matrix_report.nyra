// "[2 -1; 1 3]" -> [[2, -1], [1, 3]]
fn parse(text: str) -> [[int]] = text.slice(1, text.len() - 1).split("; ").map(row => row.split(" ").map(w => int(w)))
ex parse("[2 -1; 1 3]") == [[2, -1], [1, 3]]

fn transpose(a: [[int]]) -> [[int]] = [[a[i][j] for i in 0..a.len()] for j in 0..a[0].len()]
ex transpose([[1, 2, 3], [4, 5, 6]]) == [[1, 4], [2, 5], [3, 6]]

fn dot(x: [int], y: [int]) -> int = [x[k] * y[k] for k in 0..x.len()].sum()

fn mul(a: [[int]], b: [[int]]) -> [[int]] {
    let bt = transpose(b)
    ret [[dot(row, col) for col in bt] for row in a]
}
ex mul([[1, 2], [3, 4]], [[0, 1], [1, 0]]) == [[2, 1], [4, 3]]

// the matrix without row 0 and column `col`
fn minor(a: [[int]], col: int) -> [[int]] = [[a[i][j] for j in 0..a.len() if j != col] for i in 1..a.len()]

fn det(a: [[int]]) -> int {
    if a.len() == 1 { ret a[0][0] }
    var total = 0
    var sign = 1
    for j in 0..a.len() {
        total += sign * a[0][j] * det(minor(a, j))
        sign = -sign
    }
    ret total
}
ex det([[1, 2], [3, 4]]) == -2, det([[5]]) == 5

fn show(title: str, m: [[int]]) {
    print(title)
    let widths = [m.map(row => str(row[j]).len()).max() for j in 0..m[0].len()]
    for row in m {
        print([str(row[j]).pad_left(widths[j]) for j in 0..row.len()].join("  "))
    }
}

let a = parse("[2 -1 0; 1 3 -2; 0 4 1]")
let b = parse("[1 2; -3 0; 5 -1]")
let c = parse("[2 -1; 1 3]")
let d = parse("[3 1 2 -1; 1 2 0 -2; 4 -1 6 -3; 5 0 2 1]")
let ab = mul(a, b)
show("A*B", ab)
show("(A*B)^T", transpose(ab))
var c6 = c
for _ in 0..5 { c6 = mul(c6, c) }
show("C^6", c6)
let aa = mul(a, a)
show("A*A-3A+2I", [[aa[i][j] - 3 * a[i][j] + (if i == j { 2 } else { 0 }) for j in 0..3] for i in 0..3])
print("det(D) = {det(d)}")
