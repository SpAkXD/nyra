var on_hand: [str: int] = [:]
var reserved: [str: int] = [:]

fn available(name: str) -> int = on_hand[name] - reserved[name]
fn signed(d: int) -> str = if d > 0 { "+{d}" } else { str(d) }

let commands = "receive bolt 12; reserve bolt 9; reserve nut 1; receive nut 4; reserve bolt 4; receive bolt 10; ship bolt 11; release bolt 1; reserve bolt 7; count bolt 6; count bolt 15; release bolt 7; ship nut 4; ship nut 1; receive washer 30; reserve washer 25; ship washer 1; count washer 26; count nut 0; ship bolt 15; receive bolt 5; release gear 2"
for command in commands.split("; ") {
    let w = command.split(" ")
    let op = w[0]
    let name = w[1]
    let n = int(w[2])
    if op == "receive" && !on_hand.has(name) {
        on_hand[name] = 0
        reserved[name] = 0
    }
    if !on_hand.has(name) {
        print("{name} unknown")
        continue
    }
    let before = available(name)
    var ok = true
    if op == "receive" {
        on_hand[name] += n
        print("{name} on-hand {on_hand[name]} available {available(name)}")
    } else if op == "reserve" {
        if n > before {
            ok = false
            print("{name} reserve rejected (available {before})")
        } else {
            reserved[name] += n
            print("{name} reserved {reserved[name]} available {available(name)}")
        }
    } else if op == "release" {
        if n > reserved[name] {
            ok = false
            print("{name} release rejected (reserved {reserved[name]})")
        } else {
            reserved[name] -= n
            print("{name} reserved {reserved[name]} available {available(name)}")
        }
    } else if op == "ship" {
        if n > on_hand[name] {
            ok = false
            print("{name} ship rejected (on-hand {on_hand[name]})")
        } else {
            on_hand[name] -= n
            reserved[name] = max(reserved[name] - n, 0)
            print("{name} shipped {n} on-hand {on_hand[name]} reserved {reserved[name]}")
        }
    } else if op == "count" {
        if n < reserved[name] {
            ok = false
            print("{name} count rejected (reserved {reserved[name]})")
        } else {
            print("{name} adjusted by {signed(n - on_hand[name])}")
            on_hand[name] = n
        }
    }
    if ok && available(name) < 5 && before >= 5 { print("{name} low stock") }
}
print("---")
var names = on_hand.keys()
names.sort()
for name in names {
    print("{name}: on-hand {on_hand[name]}, reserved {reserved[name]}, available {available(name)}")
}
