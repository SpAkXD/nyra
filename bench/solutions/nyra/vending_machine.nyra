let values = [100, 25, 10, 5]                  // the coins, largest first
var store = [100: 0, 25: 2, 10: 1, 5: 3]       // coins in the machine, by value
let price = ["A1": 65, "A2": 100, "B1": 45, "B2": 120]
var stock = ["A1": 3, "A2": 1, "B1": 0, "B2": 2]
var credit = 0

// the coins of the change for `amount`, greedily from the largest value: value -> count
fn change_coins(amount: int) -> [int: int] {
    var left = amount
    var taken: [int: int] = [:]
    for v in values {
        let n = min(left / v, store[v])
        taken[v] = n
        left -= n * v
    }
    ret taken
}

fn coins_value(counts: [int: int]) -> int = values.map(v => v * counts[v]).sum()

fn coin_list(counts: [int: int]) -> str {
    let parts = values.filter(v => counts[v] > 0).map(v => "{v}x{counts[v]}")
    ret if parts.len() == 0 { "none" } else { parts.join(" ") }
}

let events = "insert 25; insert 25; insert 3; select A1; insert 25; select A1; insert 100; select B1; select C9; select A2; select A2; insert 100; insert 25; select B2; insert 100; select A1; insert 100; select A1; cancel; insert 10; insert 10; insert 10; insert 100; select A1; cancel; select B2; insert 50; cancel"
for event in events.split("; ") {
    let w = event.split(" ")
    if w[0] == "insert" {
        let n = int(w[1])
        if !values.contains(n) {
            print("rejected {n}")
        } else {
            store[n] += 1
            credit += n
            print("credit {credit}")
        }
    } else if w[0] == "select" {
        let s = w[1]
        if !price.has(s) {
            print("no slot {s}")
        } else if stock[s] == 0 {
            print("{s} sold out")
        } else if credit < price[s] {
            print("{s} costs {price[s]}, insert {price[s] - credit} more")
        } else {
            let amount = credit - price[s]
            let taken = change_coins(amount)
            if coins_value(taken) != amount {
                print("{s} exact change only")
            } else {
                stock[s] -= 1
                credit = 0
                for v in values { store[v] -= taken[v] }
                print("{s} vended, change {coin_list(taken)}")
            }
        }
    } else if w[0] == "cancel" {
        let taken = change_coins(credit)
        for v in values { store[v] -= taken[v] }
        let owed = credit - coins_value(taken)
        credit = 0
        print("returned {coin_list(taken)}" + (if owed > 0 { " (owed {owed})" } else { "" }))
    }
}
print("stock " + price.keys().map(s => "{s} {stock[s]}").join(" "))
print("coins " + values.map(v => "{v}x{store[v]}").join(" "))
