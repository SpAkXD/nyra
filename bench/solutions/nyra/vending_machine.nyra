struct Slot {
    name: str
    price: int
    stock: int
}

// the coins of the change, greedily from the largest value, as counts parallel to `values`
fn change_coins(values: [int], store: [int], amount: int) -> [int] {
    var left = amount
    var taken = [0].repeat(values.len())
    for i in 0..values.len() {
        var n = left / values[i]
        if n > store[i] { n = store[i] }
        taken[i] = n
        left -= n * values[i]
    }
    ret taken
}

fn coins_value(values: [int], counts: [int]) -> int {
    var total = 0
    for i in 0..values.len() { total += values[i] * counts[i] }
    ret total
}

fn coin_list(values: [int], counts: [int]) -> str {
    var parts: [str] = []
    for i in 0..values.len() {
        if counts[i] > 0 { parts.push("{values[i]}x{counts[i]}") }
    }
    ret if parts.len() == 0 { "none" } else { parts.join(" ") }
}

fn main() {
    let values = [100, 25, 10, 5]
    var store = [0, 2, 1, 3]
    var slots = [
        Slot(name: "A1", price: 65, stock: 3),
        Slot(name: "A2", price: 100, stock: 1),
        Slot(name: "B1", price: 45, stock: 0),
        Slot(name: "B2", price: 120, stock: 2),
    ]
    var credit = 0
    let events = "insert 25; insert 25; insert 3; select A1; insert 25; select A1; insert 100; select B1; select C9; select A2; select A2; insert 100; insert 25; select B2; insert 100; select A1; insert 100; select A1; cancel; insert 10; insert 10; insert 10; insert 100; select A1; cancel; select B2; insert 50; cancel"
    for event in events.split("; ") {
        let w = event.split(" ")
        if w[0] == "insert" {
            let n = int(w[1])
            let c = values.index_of(n)
            if c < 0 {
                print("rejected {n}")
            } else {
                store[c] += 1
                credit += n
                print("credit {credit}")
            }
        } else if w[0] == "select" {
            let s = w[1]
            var k = -1
            for i in 0..slots.len() {
                if slots[i].name == s { k = i }
            }
            if k < 0 {
                print("no slot {s}")
            } else if slots[k].stock == 0 {
                print("{s} sold out")
            } else if credit < slots[k].price {
                print("{s} costs {slots[k].price}, insert {slots[k].price - credit} more")
            } else {
                let amount = credit - slots[k].price
                let taken = change_coins(values, store, amount)
                if coins_value(values, taken) != amount {
                    print("{s} exact change only")
                } else {
                    slots[k].stock -= 1
                    credit = 0
                    for i in 0..values.len() { store[i] -= taken[i] }
                    print("{s} vended, change {coin_list(values, taken)}")
                }
            }
        } else if w[0] == "cancel" {
            let taken = change_coins(values, store, credit)
            for i in 0..values.len() { store[i] -= taken[i] }
            let owed = credit - coins_value(values, taken)
            credit = 0
            let list = coin_list(values, taken)
            if owed > 0 {
                print("returned {list} (owed {owed})")
            } else {
                print("returned {list}")
            }
        }
    }
    print("stock A1 {slots[0].stock} A2 {slots[1].stock} B1 {slots[2].stock} B2 {slots[3].stock}")
    print("coins 100x{store[0]} 25x{store[1]} 10x{store[2]} 5x{store[3]}")
}
