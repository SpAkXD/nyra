let rows = 5
let cols = 6
var board = [['.'].repeat(cols)].repeat(rows)   // row 0 is the top row

// how many discs of the same player follow (r, c) in the direction (dr, dc)
fn count_dir(r: int, c: int, dr: int, dc: int) -> int {
    var n = 0
    var rr = r + dr
    var cc = c + dc
    while rr >= 0 && rr < rows && cc >= 0 && cc < cols && board[rr][cc] == board[r][c] {
        n += 1
        rr += dr
        cc += dc
    }
    ret n
}

fn wins(r: int, c: int) -> bool {
    let drs = [0, 1, 1, 1]
    let dcs = [1, 0, 1, -1]
    for k in 0..4 {
        if 1 + count_dir(r, c, drs[k], dcs[k]) + count_dir(r, c, -drs[k], -dcs[k]) >= 4 { ret true }
    }
    ret false
}

fn play(k: int, moves: [int]) {
    board = [['.'].repeat(cols)].repeat(rows)
    var result = ""
    for i, m in moves {
        let player = if i % 2 == 0 { 'X' } else { 'O' }
        let col = m - 1
        if col < 0 || col >= cols || board[0][col] != '.' {
            result = "illegal move {i + 1} by {player}"
            break
        }
        var r = rows - 1
        while board[r][col] != '.' { r -= 1 }
        board[r][col] = player
        if wins(r, col) {
            result = "{player} wins at move {i + 1}"
            break
        }
    }
    if result == "" {
        result = if board[0].contains('.') { "no winner after {moves.len()} moves" } else { "draw" }
    }
    print("game {k}: {result}")
    for row in board { print(row.join("")) }
}

let games = [
    [3, 4, 3, 4, 3, 4, 3],
    [1, 2, 2, 3, 3, 4, 3, 4, 4, 6, 4],
    [6, 6, 6, 6, 6, 6],
    [2, 3, 4, 5, 1, 2, 3, 4, 7],
    [1, 1, 2, 2, 4, 4, 3, 5, 5],
    [4, 3, 3, 2, 2, 1, 2, 1, 1, 5, 1],
    [1, 2, 3, 4, 5, 6, 6, 5],
]
for k, moves in games { play(k + 1, moves) }
