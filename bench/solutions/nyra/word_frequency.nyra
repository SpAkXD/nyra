let stops = "the and for are but not you all any can had her was one our out his has".split(" ")

fn strip_quotes(s: str) -> str {
    var a = 0
    var b = s.len()
    while a < b && s[a] == '\'' { a += 1 }
    while b > a && s[b - 1] == '\'' { b -= 1 }
    ret s.slice(a, b)
}
ex strip_quotes("''hi''") == "hi", strip_quotes("rabbit's") == "rabbit's", strip_quotes("''") == ""

let text = "The rabbit's hole was deep; the rabbit didn't stop. 'Down, down, down!' said Alice -- and down-hill she went, past rabbit-holes, shelves, maps and jars. Was it 3 o'clock? It wasn't: the clock said half-past 4. ''Curious,'' thought Alice, ''curiouser'' -- and the rabbit's watch said nothing at all. DOWN went the jars, down went the maps; Alice didn't mind, didn't care, didn't stop. The rabbit's ears twitched; the rabbit whispered."
// words are runs of letters and apostrophes; anything else separates them
let cleaned = [if (c >= 'a' && c <= 'z') || c == '\'' { c } else { ' ' } for c in text.lower()].join("")
var counts: [str: int] = [:]
for candidate in cleaned.split(" ") {
    let w = strip_quotes(candidate)
    if w.len() >= 3 && !stops.contains(w) { counts[w] = counts.get(w, 0) + 1 }
}
var words = counts.keys()
words.sort()
var longest = words[0]
for w in words {
    if w.len() > longest.len() { longest = w }
}
words.sort_by(w => -counts[w])   // stable: equal counts stay in alphabetical order
for w in words.slice(0, 8) {
    let num = str(counts[w])
    print(w + ".".repeat(24 - w.len() - num.len()) + num)
}
print("distinct: {counts.len()}")
print("longest: {longest}")
