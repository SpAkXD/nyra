// literal braces in strings are doubled
let lines = [
    "; settings",
    "title = demo",
    "[server]",
    "host = example.org",
    "port = 8080",
    "name = \"  main  \"",
    "port = 9090",
    "[paths]",
    "root = /srv",
    "logs = ${{paths.root}}/logs",
    "data = ${{root}}/data",
    "bad line here",
    "[ server ]",
    "url = http://${{host}}:${{port}}/",
    "alias = ${{missing}}",
    "= value",
    "   # indented comment",
    "",
    "[paths]",
    "tags += web",
    "tags += api",
    "root = /var",
    "quoted = \"${{root}}\"",
    "[extra]",
    "formula = x=y+1",
    "mirror = ${{server.url}}${{paths.root}}",
    "broken = ${{paths.data}}${{server.nope}}",
    "half = \"open",
]
var settings: [str: str] = [:]    // "section.key" -> value
var current = ""                  // the section being read
var missing = ""                  // set by expand: the first unknown reference

// VALUE with every ${S.K} and ${K} replaced from left to right; "" when a reference is unknown
fn expand(value: str) -> str {
    var out = ""
    var rest = value
    while rest.contains("${{") {
        let start = rest.index_of("${{")
        let after = rest.slice(start + 2, rest.len())
        let close = after.index_of("}}")
        if close < 0 { break }
        let r = after.slice(0, close)
        let id = if r.contains(".") { r } else { "{current}.{r}" }
        if !settings.has(id) {
            missing = r
            ret ""
        }
        out += rest.slice(0, start) + settings[id]
        rest = after.slice(close + 1, after.len())
    }
    ret out + rest
}

var has_section = false
for i, line in lines {
    let n = i + 1
    let t = line.trim()
    if t == "" || t.starts_with(";") || t.starts_with("#") { continue }
    if t.starts_with("[") && t.ends_with("]") {
        current = t.slice(1, t.len() - 1).trim()
        has_section = true
        continue
    }
    let eq = line.index_of("=")
    if eq < 0 { print("line {n}: syntax error") continue }
    var left = line.slice(0, eq)
    let append = left.ends_with("+")
    if append { left = left.slice(0, left.len() - 1) }
    let key = left.trim()
    let raw = line.slice(eq + 1, line.len()).trim()
    if key == "" { print("line {n}: empty key") continue }
    if !has_section { print("line {n}: no section") continue }
    let quoted = raw.len() >= 2 && raw.starts_with("\"") && raw.ends_with("\"")
    missing = ""
    let value = if quoted { raw.slice(1, raw.len() - 1) } else { expand(raw) }
    if missing != "" { print("line {n}: unknown reference {missing}") continue }
    let id = "{current}.{key}"
    if append && settings.has(id) { settings[id] += "," + value } else { settings[id] = value }
}
print("---")
var ids = settings.keys()
ids.sort()
for id in ids { print("{id} = [{settings[id]}]") }
