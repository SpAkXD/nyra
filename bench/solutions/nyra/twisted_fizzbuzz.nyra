fn has_seven(n: int) -> bool = str(n).contains('7')

for n in 1..41 {
    if has_seven(n) {
        print("Seven")
    } else if n % 12 == 0 {
        print("Twelve")
    } else if n % 3 == 0 {
        print("Three")
    } else if n % 4 == 0 {
        print("Four")
    } else {
        print(n)
    }
}
