fn is_prime(n: int) -> bool {
    if n < 2 { ret false }
    var d = 2
    while d * d <= n {
        if n % d == 0 { ret false }
        d = d + 1
    }
    ret true
}

fn show(n: int) {
    if is_prime(n) { print("true") } else { print("false") }
}

fn main() {
    show(1)
    show(2)
    show(3)
    show(4)
    show(17)
    show(25)
    show(97)
    show(100)
    show(7919)
}
