let seats = 10
let letters = "ABCDEF"
let broken = "!"   // never a group name
// the owner of each seat by row and seat (from 0); "" is free
var hall = [[""].repeat(seats)].repeat(6)
hall[2][4] = broken
hall[2][5] = broken
hall[4][0] = broken

let requests = "ann 4; bob 4; cat 2; dan 10; eve 1; fay 6; cancel bob; gus 5; hal 3; cancel zed; ivy 9; jo 2; kai 8; lea 3"
for request in requests.split("; ") {
    let w = request.split(" ")
    if w[0] == "cancel" {
        let name = w[1]
        let n = hall.map(row => row.count(o => o == name)).sum()
        hall = hall.map(row => row.map(o => if o == name { "" } else { o }))
        print(if n == 0 { "{name} has no booking" } else { "{name} cancelled ({n} seats)" })
        continue
    }
    let name = w[0]
    let k = int(w[1])
    var booked = false
    for letter in ["C", "D", "B", "E", "A", "F"] {
        let r = letters.index_of(letter)
        // the best block start (seat number from 1); distances are doubled to stay whole
        var best = -1
        var best_dist = 0
        for start in 1..seats - k + 2 {
            if hall[r].slice(start - 1, start + k - 1).all(o => o == "") {
                let dist = abs(2 * start + k - 1 - 11)
                if best < 0 || dist < best_dist {
                    best = start
                    best_dist = dist
                }
            }
        }
        if best > 0 {
            for s in best..best + k { hall[r][s - 1] = name }
            print(if k == 1 { "{name}: {letter}{best}" } else { "{name}: {letter}{best}-{letter}{best + k - 1}" })
            booked = true
            break
        }
    }
    if !booked { print("{name}: no room") }
}
for r, row in hall {
    print("{letters[r]} " + row.map(o => if o == broken { "x" } else if o == "" { "." } else { "#" }).join(""))
}
