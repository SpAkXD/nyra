struct Maze {
    cells: [[char]]
    keys: [char]
}

fn pow2(k: int) -> int {
    var p = 1
    for i in 0..k { p *= 2 }
    ret p
}

fn has_key(mask: int, k: int) -> bool = (mask / pow2(k)) % 2 == 1

fn height(m: Maze) -> int = m.cells.len()
fn width(m: Maze) -> int = m.cells[0].len()
fn masks(m: Maze) -> int = pow2(m.keys.len())

fn state_of(m: Maze, r: int, c: int, mask: int) -> int = (r * width(m) + c) * masks(m) + mask

fn move_dr(d: int) -> int = [1, 0, 0, -1][d]
fn move_dc(d: int) -> int = [0, -1, 1, 0][d]
fn move_name(d: int) -> str = ["D", "L", "R", "U"][d]

// the state after moving in direction d from state s, or -1 if the move is not allowed
fn step(m: Maze, s: int, d: int) -> int {
    let mask = s % masks(m)
    let pos = s / masks(m)
    let r = pos / width(m) + move_dr(d)
    let c = pos % width(m) + move_dc(d)
    if r < 0 || r >= height(m) || c < 0 || c >= width(m) { ret -1 }
    let cell = m.cells[r][c]
    if cell == '#' { ret -1 }
    var next_mask = mask
    if cell.is_upper() && cell != 'S' && cell != 'G' {
        let k = m.keys.index_of(cell.lower())
        if k < 0 || !has_key(mask, k) { ret -1 }
    }
    if cell.is_lower() {
        let k = m.keys.index_of(cell)
        if !has_key(mask, k) { next_mask += pow2(k) }
    }
    ret state_of(m, r, c, next_mask)
}

fn at_goal(m: Maze, s: int) -> bool {
    let pos = s / masks(m)
    ret m.cells[pos / width(m)][pos % width(m)] == 'G'
}

fn solve(rows: [str]) -> str {
    var cells: [[char]] = []
    var keys: [char] = []
    var start = 0
    for r in 0..rows.len() {
        cells.push(rows[r].chars())
        for c in 0..rows[r].len() {
            let ch = rows[r][c]
            if ch.is_lower() && !keys.contains(ch) { keys.push(ch) }
        }
    }
    let m = Maze(cells: cells, keys: keys)
    for r in 0..rows.len() {
        for c in 0..rows[r].len() {
            if rows[r][c] == 'S' { start = state_of(m, r, c, 0) }
        }
    }
    let total = height(m) * width(m) * masks(m)
    var dist = [-1].repeat(total)
    var order = [start]
    dist[start] = 0
    var best = -1
    var head = 0
    while head < order.len() {
        let s = order[head]
        head += 1
        if at_goal(m, s) {
            if best < 0 { best = dist[s] }
            continue
        }
        for d in 0..4 {
            let t = step(m, s, d)
            if t >= 0 && dist[t] < 0 {
                dist[t] = dist[s] + 1
                order.push(t)
            }
        }
    }
    if best < 0 { ret "no path" }
    // good[s]: s lies on a shortest path from S to G
    var good = [false].repeat(total)
    var i = order.len() - 1
    while i >= 0 {
        let s = order[i]
        if at_goal(m, s) {
            good[s] = dist[s] == best
        } else {
            for d in 0..4 {
                let t = step(m, s, d)
                if t >= 0 && dist[t] == dist[s] + 1 && good[t] { good[s] = true }
            }
        }
        i -= 1
    }
    var path = ""
    var s = start
    while !at_goal(m, s) {
        for d in 0..4 {
            let t = step(m, s, d)
            if t >= 0 && dist[t] == dist[s] + 1 && good[t] {
                path += move_name(d)
                s = t
                break
            }
        }
    }
    ret "{best} moves {path}"
}

fn main() {
    let mazes = [
        ["S...#", ".##.#", "....G"],
        ["#########", "#S..A..G#", "#.#####.#", "#...a.#.#", "#########"],
        ["S.B.G", "#.###", "b.A.a"],
        ["#######", "#a#.#b#", "#.#.#.#", "#..S..#", "###A###", "###B###", "###G###"],
        ["S.#..", ".##.#", "...#G"],
        ["..S..", ".###.", "..G.."],
    ]
    for k in 0..mazes.len() {
        print("maze {k + 1}: {solve(mazes[k])}")
    }
}
