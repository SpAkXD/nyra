struct State {
    r: int
    c: int
    keys: int       // the keys held, one bit per letter
    path: str
}

fn pow2(k: int) -> int = [2].repeat(k).fold(1, (acc, x) => acc * x)

// breadth first, trying D, L, R, U in that order: the first path to reach a state is the first in alphabetical order
fn solve(grid: [str]) -> str {
    var queue: [State] = []
    for r, row in grid {
        if row.contains('S') { queue.push(State(r: r, c: row.index_of('S'), keys: 0, path: "")) }
    }
    var seen: [str: bool] = [:]
    var head = 0
    while head < queue.len() {
        let s = queue[head]
        head += 1
        for d in 0..4 {
            let r = s.r + [1, 0, 0, -1][d]
            let c = s.c + [0, -1, 1, 0][d]
            if r < 0 || r >= grid.len() || c < 0 || c >= grid[0].len() { continue }
            let cell = grid[r][c]
            let path = s.path + str("DLRU"[d])
            if cell == 'G' { ret "{path.len()} moves {path}" }
            if cell == '#' { continue }
            var keys = s.keys
            if cell.is_upper() && cell != 'S' {
                if keys / pow2(cell.lower().code() - 'a'.code()) % 2 == 0 { continue }   // a door without its key
            } else if cell.is_lower() {
                let bit = pow2(cell.code() - 'a'.code())
                if keys / bit % 2 == 0 { keys += bit }
            }
            let state = State(r: r, c: c, keys: keys, path: path)
            let id = "{r} {c} {state.keys}"
            if !seen.has(id) {
                seen[id] = true
                queue.push(state)
            }
        }
    }
    ret "no path"
}

let mazes = [
    ["S...#", ".##.#", "....G"],
    ["#########", "#S..A..G#", "#.#####.#", "#...a.#.#", "#########"],
    ["S.B.G", "#.###", "b.A.a"],
    ["#######", "#a#.#b#", "#.#.#.#", "#..S..#", "###A###", "###B###", "###G###"],
    ["S.#..", ".##.#", "...#G"],
    ["..S..", ".###.", "..G.."],
]
for k, grid in mazes { print("maze {k + 1}: {solve(grid)}") }
