var cells: [str: int] = [:]   // "name month" -> value; a missing cell is 0

fn cell_value(name: str, month: int) -> int = cells.get("{name} {month}", 0)

let commands = "add rent 1 900; add food 1 250; add food 2 -40; move rent 1 food 2 100; move food 2 rent 3 200; add fun 12 75; clear fun 12; clear fun 12; add rent 3 1300; move rent 3 rent 3 50; add zoo 5 0; add tax 4 -1300; move rent 3 tax 4 1300; add food 1 -250; add car 7 15; move car 7 car 8 15; add tax 10 -75; add food 10 12000; move food 10 rent 10 2500"
for command in commands.split("; ") {
    let w = command.split(" ")
    let a = "{w[1]} {w[2]}"
    if w[0] == "add" {
        cells[a] = cells.get(a, 0) + int(w[3])
        print("{a} = {cells[a]}")
    } else if w[0] == "move" {
        let b = "{w[3]} {w[4]}"
        let n = int(w[5])
        if cells.get(a, 0) < n {
            print("move rejected")
        } else {
            cells[a] = cells.get(a, 0) - n
            cells[b] = cells.get(b, 0) + n
            print("{a} = {cells[a]}, {b} = {cells[b]}")
        }
    } else if w[0] == "clear" {
        if cells.get(a, 0) == 0 {
            print("{a} already empty")
        } else {
            print("{a} cleared (was {cells[a]})")
            cells[a] = 0
        }
    }
}

// the accounts and months that have a non-zero cell
var names: [str] = []
var months: [int] = []
for key in cells {
    if cells[key] == 0 { continue }
    let p = key.split(" ")
    if !names.contains(p[0]) { names.push(p[0]) }
    if !months.contains(int(p[1])) { months.push(int(p[1])) }
}
names.sort()
months.sort()

// the table as text, one row of cells per line
var rows = [["account"] + months.map(m => str(m)) + ["total"]]
for name in names {
    let values = months.map(m => cell_value(name, m))
    rows.push([name] + values.map(v => if v == 0 { "-" } else { str(v) }) + [str(values.sum())])
}
let col_sums = months.map(m => names.map(n => cell_value(n, m)).sum())
rows.push(["total"] + col_sums.map(s => str(s)) + [str(col_sums.sum())])

let widths = [rows.map(row => row[j].len()).max() for j in 0..rows[0].len()]
for row in rows {
    print([if j == 0 { row[j].pad_right(widths[j]) } else { row[j].pad_left(widths[j]) } for j in 0..row.len()].join("  "))
}
