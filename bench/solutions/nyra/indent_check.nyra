struct Open {
    bracket: char
    line: int
}

let closer = ['(': ')', '[': ']', '{': '}']

fn is_closing(c: char) -> bool = closer.values().contains(c)

// the first error of a snippet, or "" when it has none
fn check(lines: [str]) -> str {
    var stack: [Open] = []
    var indents: [int] = []
    var prev_opens = false      // the previous line ends with an opening bracket
    for k, raw in lines {
        let line_no = k + 1
        let bar = raw.index_of("|")
        let indent = int(raw.slice(0, bar))
        let text = raw.slice(bar + 1, raw.len())
        indents.push(indent)

        // rule 1: brackets; remember the line whose bracket the first character closes
        var first_closes = -1
        for i, c in text {
            if closer.has(c) {
                stack.push(Open(bracket: c, line: line_no))
            } else if is_closing(c) {
                if stack.len() == 0 { ret "line {line_no}: unexpected {c}" }
                let top = stack.pop()
                let want = closer[top.bracket]
                if want != c { ret "line {line_no}: expected {want} but found {c}" }
                if i == 0 { first_closes = top.line }
            }
        }

        // rule 2: indentation
        var expected = 0
        if k > 0 {
            if is_closing(text[0]) {
                expected = indents[first_closes - 1]
            } else if prev_opens {
                expected = indents[k - 1] + 4
            } else {
                expected = indents[k - 1]
            }
        }
        if indent != expected { ret "line {line_no}: indent {indent}, expected {expected}" }
        prev_opens = closer.has(text[text.len() - 1])
    }
    if stack.len() > 0 {
        let top = stack[stack.len() - 1]
        ret "line {top.line}: unclosed {top.bracket}"
    }
    ret ""
}

// literal braces in strings are doubled
let snippets = [
    ["0|fn main() {{", "4|let xs = [1, 2,", "4|3]", "4|if x {{", "8|call(a, [b,", "8|c])", "4|}}", "0|}}"],
    ["0|f(a, {{", "4|b: [1, 2)", "0|}})"],
    ["0|g {{", "2|h()", "0|}}"],
    ["0|a {{", "4|b {{", "8|c", "4|}}", "4|}}"],
    ["0|x", "0|)"],
    ["0|k(", "4|m[", "8|n", "4|]"],
    ["2|a"],
    ["0|f() {{", "0|}}", "0|g [", "4|1, (2", "4|)]"],
    ["0|if a {{", "4|b", "0|}} else {{", "4|c", "0|}}"],
    ["0|p {{", "3|q)"],
    ["0|r([", "4|s", "0|])", "0|t"],
]
for k, snippet in snippets {
    let err = check(snippet)
    let result = if err == "" { "ok" } else { err }
    print("snippet {k + 1}: {result}")
}
