fn cell(day: int, days: int) -> str = if day < 1 || day > days { "  " } else { str(day).pad_left(2) }
ex cell(0, 31) == "  ", cell(7, 31) == " 7", cell(31, 31) == "31"

let days = 31
let first = 2 // Monday is 0, so Wednesday is 2
print("Mo Tu We Th Fr Sa Su")
for monday in 1 - first..days + 1 step 7 {
    print([cell(d, days) for d in monday..monday + 7 if d <= days].join(" "))
}
