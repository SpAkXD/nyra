+def cmd_interest(bank: Bank, args: list) -> None:
+    if len(args) != 2:
+        print("error: usage: interest RATE")
+        return
+    rate = parse_amount(args[1])
+    if rate < 0:
+        print("error: bad rate")
+        return
+    paid = 0
+    for account in sorted(bank.accounts, key=lambda a: a.name):
+        if account.balance <= 0:
+            continue
+        interest = account.balance * rate // 10000
+        if interest > 0:
+            account.balance += interest
+            account.history.append(f"interest +{money(interest)}")
+            print(f"interest paid to {account.name}: +{money(interest)}")
+            paid += 1
+    if paid == 0:
+        print("no interest paid")
+
