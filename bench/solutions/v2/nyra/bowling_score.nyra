use input
use text

fn parse_rolls(line: str) -> [int] {
    var rolls: [int] = []
    for t in line.split(" ") {
        if t.len() < 1 || t.len() > 2 || !t.all(c => c.is_digit()) || (t.len() == 2 && t[0] == '0') { ret [-1] }
        let v = int(t)
        if v > 10 { ret [-1] }
        rolls.push(v)
    }
    ret rolls
}

// the score of a game, or -1 when the rolls are not exactly one complete, legal game
fn score(r: [int]) -> int {
    if r.len() > 0 && r[0] < 0 { ret -1 }
    var total = 0
    var i = 0
    for frame in 1..11 {
        if i >= r.len() { ret -1 }
        if frame < 10 {
            if r[i] == 10 {
                if i + 2 >= r.len() { ret -1 }
                total += 10 + r[i + 1] + r[i + 2]
                i += 1
            } else {
                if i + 1 >= r.len() || r[i] + r[i + 1] > 10 { ret -1 }
                total += r[i] + r[i + 1]
                if r[i] + r[i + 1] == 10 {
                    if i + 2 >= r.len() { ret -1 }
                    total += r[i + 2]
                }
                i += 2
            }
        } else {
            if r[i] == 10 {
                if r.len() - i != 3 { ret -1 }
                let a = r[i + 1]
                let b = r[i + 2]
                if a != 10 && a + b > 10 { ret -1 }
                total += 10 + a + b
            } else {
                if i + 1 >= r.len() || r[i] + r[i + 1] > 10 { ret -1 }
                if r[i] + r[i + 1] == 10 {
                    if r.len() - i != 3 { ret -1 }
                    total += 10 + r[i + 2]
                } else {
                    if r.len() - i != 2 { ret -1 }
                    total += r[i] + r[i + 1]
                }
            }
        }
    }
    ret total
}

for line in input.lines() {
    if line.trim() == "" { continue }
    let s = score(parse_rolls(line))
    if s < 0 { print("invalid") } else { print(s) }
}
