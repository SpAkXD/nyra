use input

let grid = input.lines()
let h = grid.len()
var w = 0
if h > 0 { w = grid[0].len() }
var seen = [false].repeat(h * w)
var islands = 0
var largest = 0
for r in 0..h {
    for c in 0..w {
        if grid[r][c] == '#' && !seen[r * w + c] {
            islands += 1
            var size = 0
            var stack: [int] = [r * w + c]
            seen[r * w + c] = true
            while stack.len() > 0 {
                let cur = stack.pop()
                size += 1
                let y = cur / w
                let x = cur % w
                for dy in -1..2 {
                    for dx in -1..2 {
                        let ny = y + dy
                        let nx = x + dx
                        if ny >= 0 && ny < h && nx >= 0 && nx < w && grid[ny][nx] == '#' && !seen[ny * w + nx] {
                            seen[ny * w + nx] = true
                            stack.push(ny * w + nx)
                        }
                    }
                }
            }
            largest = max(largest, size)
        }
    }
}
print("islands={islands} largest={largest}")
