use input

let lines = input.lines()
let k = int(lines[0].trim())
var counts: [str: int] = [:]
for i in 1..lines.len() {
    var word = ""
    for c in lines[i] + " " {
        if c.is_letter() {
            word += str(c.lower())
        } else if word != "" {
            counts[word] = counts.get(word, 0) + 1
            word = ""
        }
    }
}
var words = counts.keys()
if words.len() == 0 {
    print("no words")
} else {
    // selection: the most frequent first, equal counts alphabetically
    var shown = 0
    var used: [str] = []
    while shown < k && shown < words.len() {
        var best = ""
        for w in words {
            if used.contains(w) { continue }
            if best == "" || counts[w] > counts[best] || (counts[w] == counts[best] && w < best) { best = w }
        }
        used.push(best)
        print("{best} {counts[best]}")
        shown += 1
    }
}
