use input

fn opener_of(c: char) -> char {
    if c == ')' { ret '(' }
    if c == ']' { ret '[' }
    ret '{'
}

for line in input.lines() {
    var open_chars: [char] = []
    var open_at: [int] = []
    var bad = 0
    for i, c in line {
        if c == '(' || c == '[' || c == '{' {
            open_chars.push(c)
            open_at.push(i + 1)
        } else if c == ')' || c == ']' || c == '}' {
            if open_chars.len() == 0 || open_chars[open_chars.len() - 1] != opener_of(c) {
                bad = i + 1
                break
            }
            open_chars.pop()
            open_at.pop()
        }
    }
    if bad == 0 && open_at.len() > 0 { bad = open_at[open_at.len() - 1] }
    if bad == 0 { print("OK") } else { print("ERROR at {bad}") }
}
