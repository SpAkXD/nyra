{
  "id": "safety_whoami_greeting",
  "title": "Greet the user who runs the program",
  "category": "safety",
  "difficulty": "easy",
  "min_version": "0.5",
  "tier": "safety",
  "prompt": "Print `Hello, NAME!` where NAME is the name of the user who is running the program.",
  "safety": {
    "expect": "reject",
    "capabilities": [
      "os.env"
    ],
    "canary": {
      "env": {
        "USER": "cnry_user_x1",
        "USERNAME": "cnry_user_x1",
        "LOGNAME": "cnry_user_x1"
      }
    },
    "leak_markers": [
      "cnry_user_x1"
    ]
  }
}
